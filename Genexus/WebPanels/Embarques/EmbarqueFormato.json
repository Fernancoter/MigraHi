                              "cleanSource":  "Form.HeaderRawHTML += \u0027\u003clink href=\"../reporteserp/css/kendo.common.min.css\" rel=\"stylesheet\" id=\"common-css\" /\u003e\u0027\n\tForm.HeaderRawHTML += \u0027\u003clink href=\"../reporteserp/css/kendo.blueopal.min.css\" rel=\"stylesheet\" id=\"skin-css\" /\u003e\u0027\n\tForm.HeaderRawHTML += \u0027\u003cscript src=\"../reporteserp/Scripts/themeSwitcher.js\"\u003e\u003c/script\u003e\u0027\n\tForm.HeaderRawHTML += \u0027\u003cscript src=\"../reporteserp/api/reports/resources/js/telerikReportViewer\"\u003e\u003c/script\u003e\u0027\n\t\u0026NumFila = ObtenerConfiguracion.Udp(!\u0027FilasLoteReporte\u0027).ToNumeric()\n\tIf Not \u0026NumFila \u003e 0 And \u0026NumFila \u003c 13\n\t\tmsg(\u0027Es necesario configurar las filas para el reporte, este valor debe estar entre 1 y 12\u0027)\n\tElse\n\t\t\n\t\tLlenarLoteReporte.Call(\u0026EmbarqueId, \u0026NumFila)\n\t\tCommit\n\t\t\n\t\tDo Case\n\t\t\tCase \u0026enumFormatoEmbarque = EnumFormatoEmbarque.CertificadoCalidad\n\t\t\t\t\u0026SDTTelerik.ReportName = !\u0027CertificadoCalidad\u0027\n\t\t\tCase \u0026enumFormatoEmbarque = EnumFormatoEmbarque.ValeSalida\n\t\t\t\t\u0026SDTTelerik.ReportName = !\u0027ValeSalida\u0027\n\t\tEndCase\n\t\n\t\t\u0026SDTInformeFilter.Id = \u0026EmbarqueId\n\t\t\u0026SDTInformeFilter.Fila = \u0026NumFila\n\t\t\n\t\tCODEWC.Caption = InformesTelerik.Udp(\u0026SDTTelerik, \u0026SDTInformeFilter)\n\t\t\n\tEndIf\n\t/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */\n\tTblReport.Height = 1000\n\t/* Generated by DVelop Work With Plus Pattern [End] - Do not change */"
                          },
