                              "rawSource":  "(Extracted from full RTF)",
                              "cleanSource":  "LinkAPK.Link = link(\u0027HICONE.apk\u0027)\n\tLayoutMainTable.Class = ThemeClass:MainContainerNoBackground\n\tRegisterUser.Link = GAMRegisterUser.Link()\n\tCurrentRepository.Visible\t= False\n\tTableButtons.Visible\t\t= False\n\t\n\t//Valid current connection\n\t\u0026isConnectionOK = GeneXusSecurity.GAM.CheckConnection()\n\tIf GeneXusSecurity.GAM.isMultitenant()\n\t\tDo \u0027isMultitenantInstallation\u0027\n\tElse\n\t\tIf not \u0026isConnectionOK\n\t\t\tIf GeneXusSecurity.GAM.GetDefaultRepository(\u0026RepositoryGUID)\n\t\t\t\t\u0026isConnectionOK = GeneXusSecurity.GAM.SetConnectionByRepositoryGUID(\u0026RepositoryGUID, \u0026Errors)\n\t\t\tElse\n\t\t\t\t\u0026ConnectionInfoCollection = GeneXusSecurity.GAM.GetConnections()\n\t\t\t\tIf \u0026ConnectionInfoCollection.Count \u003e 0\n\t\t\t\t\t//The first connection found is established by default\n\t\t\t\t\t\u0026isConnectionOK = GeneXusSecurity.GAM.SetConnection(\u0026ConnectionInfoCollection.Item(1).Name, \u0026Errors)\n\t\t\t\tEndIf\n\t\t\tEndif\n\t\tEndif\n\tEndif\n\t/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */\n\tDo \u0027AttributesSecurityCode\u0027\n\t\u0026URL.Visible = False\n\t\u0026TypeAuthType.Visible = False\n\t\u0026NameAuthType.Visible = False\n\t/* Generated by DVelop Work With Plus Pattern [End] - Do not change */"
                          },
                          {
                              "blockName":  "GridAuthTypes.Load",
                              "blockType":  "Event",
                              "rawSource":  "(Extracted from full RTF)",
                              "cleanSource":  "For \u0026AuthenticationType in \u0026AuthenticationTypes\n\t\tIf not \u0026AuthenticationType.NeedUserName //is an Identity Provider\n\t\t\ttableloginerror.Visible =true\n\t\t\tIf not \u0026AuthenticationType.SmallImageName.IsEmpty()\n\t\t\t\t\u0026ImageAuthType.FromImage(\u0026AuthenticationType.SmallImageName)\n\t\t\tElse\n\t\t\t\t\u0026ImageAuthType.FromImage(GAMButtonGAMRemoteSmall)\n\t\t\tEndif\n\t\t\t\u0026TypeAuthType \t\t\t\t= \u0026AuthenticationType.Type\n\t\t\t\u0026NameAuthType \t\t\t\t= \u0026AuthenticationType.Name.Trim()\n\t\t\t\u0026ImageAuthType.TooltipText \t= Format(\"Sign in with %1\", \u0026AuthenticationType.Description.Trim() )\n\t\t\tIf TableButtons.Visible\t= False\n\t\t\t\tTableButtons.Visible\t= True\n\t\t\tEndIf\n\t\t\tLoad\n\t\tEndIf\n\tEndFor\n\t/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */\n\t//this code should be inside the For Each used to load the grid\n\t/* Generated by DVelop Work With Plus Pattern [End] - Do not change */"
                          },
                          {
                              "blockName":  "Enter",
                              "blockType":  "Event",
                              "rawSource":  "(Extracted from full RTF)",
                              "cleanSource":  "//Set Remember User type\n\tDo Case\n\tCase \u0026KeepMeLoggedIn\n\t\t\u0026AdditionalParameter.RememberUserType = GAMRememberUserTypes.Authentication\n\tCase \u0026RememberMe\n\t\t\u0026AdditionalParameter.RememberUserType = GAMRememberUserTypes.Login\n\tOtherwise\n\t\t\u0026AdditionalParameter.RememberUserType = GAMRememberUserTypes.None\n\tEndCase\n\t////////////////////////////////////////////////////////////\n\t//Send Custom Properties (optional) ////////////////////////\n\t//\u0026CustomGAMProperty = new()\n\t//\u0026CustomGAMProperty.Id\t\t= \"Company\"\n\t//\u0026CustomGAMProperty.Value\t= \"UY\"\n\t//\u0026AdditionalParameter.Properties.Add(\u0026CustomGAMProperty)\n\t//These properties are saved in the session when the user authenticates\n\t////////////////////////////////////////////////////////////\n\t\u0026AdditionalParameter.AuthenticationTypeName = \u0026LogOnTo\n\t\u0026AdditionalParameter.OTPStep\t\t\t\t= 1\n\t\u0026LoginOK = GeneXusSecurity.GAMRepository.Login(\u0026UserName, \u0026UserPassword, \u0026AdditionalParameter, \u0026Errors )\n\tIf \u0026LoginOK\n\t\t\n\t\t\u0026GamUser = GamUser.Get()\n\t\t\u0026GamUserAttribute = \u0026GamUser.GetAttribute(\"CompanyId\", \u0026Errors)\n\t\t\u0026WWPContext.CompanyId = \u0026GamUserAttribute.Value.ToNumeric()\n\t\t\n\t\t\u0026GamUserAttribute = \u0026GamUser.GetAttribute(\"OperadorId\", \u0026Errors)\n\t\t\u0026WWPContext.OperadorId = \u0026GamUserAttribute.Value.ToNumeric()\n\t\t\n\t\tLoadWWPContext(\u0026WWPContext)\n\t\t\u0026WWPContext.CompanyId = \u0026GamUserAttribute.Value.ToNumeric()\n\t\tSetWWPContext(\u0026WWPContext)\n\t\t\n\t\t\n\t\t\n\t\t\u0026URL = GAMRepository.GetLastErrorsURL()\n\t\tIf \u0026URL.IsEmpty()\n\t\t\thome()\n\t\tElse\n\t\t\tLink(\u0026URL)\n\t\tEndif\n\tElse\n\t\tIf \u0026Errors.Count \u003e 0 \n\t\t\tDo Case\n\t\t\tCase (\u0026Errors.Item(1).Code = GAMErrorMessages.UserPasswordExpired  OR  \u0026Errors.Item(1).Code = GAMErrorMessages.UserPasswordMustBeChanged)\n\t\t\t\t//Webpanel to Change Password\n\t\t\t\tGAMChangePassword(\u0026IDP_State)\n\t\t\tCase \u0026Errors.Item(1).Code = GAMErrorMessages.UserMissingRequiredData\n\t\t\t\t//Webpanel to Complete User data\n\t\t\t\tGAMUpdateRegisterUser(\u0026IDP_State)\n\t\t\tCase \u0026Errors.Item(1).Code = GAMErrorMessages.UserAccessCodeSent  OR  \u0026Errors.Item(1).Code = GAMErrorMessages.UserMustValidateSecondFactorToFinishAuthentication\n\t\t\t\t//Webpanel to validate access code\n\t\t\t\tGAMOTPAuthentication(\u0026IDP_State)\n\t\t\tOtherwise\n\t\t\t\t\u0026UserPassword.SetEmpty()\n\t\t\t\tDo \u0027DisplayMessages\u0027\n\t\t\tEndCase\n\t\tEndIf\n\tEndif\n\t/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */\n\t/* Generated by DVelop Work With Plus Pattern [End] - Do not change */"
                          },
                          {
                              "blockName":  "Refresh",
                              "blockType":  "Event",
                              "rawSource":  "(Extracted from full RTF)",
                              "cleanSource":  "TableLoginError.Visible = false\n\t\u0026isRedirect = False\n  \n\t//Gets last error in the GAM \n\t\u0026ErrorsLogin = GAMRepository.GetLastErrors()\n\tIf \u0026ErrorsLogin.Count \u003e 0\n\t\tDo Case\n\t\tCase \u0026ErrorsLogin.Item(1).Code = GAMErrorMessages.ConnectionNotSpecified  OR  \u0026ErrorsLogin.Item(1).Code = GAMErrorMessages.UserMustBeAuthenticated\n\t\t\t//DO NOT display these messages\n\t\tOtherwise\n\t\t\t\u0026UserPassword.SetEmpty()\n\t\t\t\u0026Errors = \u0026ErrorsLogin\n\t\t\tDo \u0027DisplayMessages\u0027\n\t\tEndCase\n\tEndif\n\tIf not \u0026isRedirect\n\t\t//Gets last error in GAM\n\t\t\u0026SessionValid = GAMSession.IsValid(\u0026Session, \u0026Errors)\n\t\tIf \u0026SessionValid and not \u0026Session.IsAnonymous\n\t\t\t\u0026URL = GAMRepository.GetLastErrorsURL()\n\t\t\tIf \u0026URL.IsEmpty()\n\t\t\t\t\u0026GAMApplicationCollection = GAMRepository.GetApplications(\u0026GAMApplicationFilter,\u0026Errors)\n\t\t\t\tFor \u0026GAMApplication in \u0026GAMApplicationCollection\n\t\t\t\t\tIf \u0026GAMApplication.GUID \u003c\u003e GAMInternalGUIDs.AppGAMUserBackend\n\t\t\t\t\t\tExit\n\t\t\t\t\tEndif\n\t\t\t\tEndFor\n\t\t\t\t\u0026GAMApplication =\t\u0026GAMApplication.Get()\n\t\t\t\tIf \u0026GAMApplication.HomeObject \u003c\u003e \u0027\u0027\n\t\t\t\t\tGAMRepository.ApplicationGoHome(\u0026GAMApplication.GUID)\n\t\t\t\tElse\n\t\t\t\t\tHome.Link()\n\t\t\t\tEndif\n\t\t\tElse\n\t\t\t\tLink(\u0026URL)\n\t\t\tEndif\n\t\tElse\n\t\t\t//List Log on to\n\t\t\t\u0026LogOnTo.Clear()\n\t\t\t\u0026AuthenticationTypes = GAMRepository.GetEnabledAuthenticationTypes(\u0026Language, \u0026Errors)\n\t\t\tFor \u0026AuthenticationType in \u0026AuthenticationTypes\n\t\t\t\tIf \u0026AuthenticationType.NeedUserName //Authentication types you must enter the username in this web panel\n\t\t\t\t\t\u0026LogOnTo.AddItem(\u0026AuthenticationType.Name, \u0026AuthenticationType.Description)\n\t\t\t\tElse\n\t\t\t\t\tGridAuthTypes.Visible = True\n\t\t\t\tEndIf\n\t\t\tEndFor\n\t\t\tIf \u0026LogOnTo.Count \t\u003c= 1\n\t\t\t\t\u0026LogOnTo.Visible = False\n\t\t\tElse\n\t\t\t\t\u0026LogOnTo = \u0026AuthenticationTypes.Item(1).Name\n\t\t\tEndif\n\t\t\t//Initialize variables if the user chooses to keep that information \n\t\t\t\u0026isOK = GAMRepository.GetRememberLogin(\u0026LogOnTo, \u0026AuxUserName, \u0026UserRememberMe, \u0026Errors)\n\t\t\tIf not \u0026AuxUserName.IsEmpty()\n\t\t\t\t\u0026UserName = \u0026AuxUserName\n\t\t\tEndif\n\t\t\tIf \u0026UserRememberMe = GAMRememberUserTypes.Login\n\t\t\t\t\u0026RememberMe = True\n\t\t\tEndif\n\t\t\t//Select Default Authentication Type, Display Remember User if it is enabled on Repository\n\t\t\t\u0026Repository = GAMRepository.Get()\n\t\t\tIf \u0026LogOnTo.Count \u003e 1\n\t\t\t\t\u0026LogOnTo = \u0026Repository.DefaultAuthenticationTypeName\n\t\t\tEndif\n\t\t\tDo \u0027DisplayCheckBox\u0027\n\t\t\tFor \u0026AuthenticationType in \u0026AuthenticationTypes\n\t\t\t\tIf \u0026AuthenticationType.Name = \u0026LogOnTo\n\t\t\t\t\tDo \"ValidLOgOnToOTP\"\n\t\t\t\t\tExit\n\t\t\t\tEndif\n\t\t\tEndFor\n\t\tEndIf\n\tEndif"
                          },
