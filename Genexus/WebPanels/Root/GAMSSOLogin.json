                              "cleanSource":  "TBback.JSEvent(\u0027onclick\u0027,\u0027history.back()\u0027)\n\t//Used when multiple repository connections exist  ////////////////////////////\n\t\u0026ConnectionInfoCollection = GeneXusSecurity.GAM.GetConnections()\n\tIf \u0026ConnectionInfoCollection.Count \u003e 0 \n\t\t//The first connection found is established by default \n\t\t\u0026isOK = GeneXusSecurity.GAM.SetConnection(\u0026ConnectionInfoCollection.Item(1).Name, \u0026Errors)\n\tEndIf\n\t///////////////////////////////////////////////////////////////////////////////\n\t\u0026isRedirect = False\n\t//Gets last error in the GAM /////////////////////////////\n\t\u0026Errors = GAMRepository.GetLastErrors()\n\tIf \u0026Errors.Count \u003e 0  AND  \u0026Errors.Item(1).Code \u003c\u003e GAMErrorMessages.UserMustBeAuthenticated\n\t\tDo \u0027DisplayMessages\u0027\n\tElse\n\t\t\u0026SessionValid = GeneXusSecurity.GAMSession.IsValid(\u0026Session, \u0026Errors)\n\t\tIf \u0026SessionValid and not \u0026Session.IsAnonymous\n\t\t\t\u0026URL = GAMRepository.GetLastErrorsURL()\n\t\t\tIf \u0026URL.IsEmpty()\n\t\t\t\thome()\n\t\t\tElse\n\t\t\t\tLink(\u0026URL)\n\t\t\tEndif\n\t\tElse\n\t\t\tGAMRepository.LoginGAMRemote()\n\t\t\t\u0026Errors = GeneXusSecurity.GAMRepository.GetLastErrors()\n\t\t\tIf \u0026Errors.Count \u003e 0\n\t\t\t\tDo \u0027DisplayMessages\u0027\n\t\t\tEndif\n\t\tEndif\n\tEndif\n\t/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */\n\t/* Generated by DVelop Work With Plus Pattern [End] - Do not change */"
                          }
