                              "rawSource":  "(Extracted from full RTF)",
                              "cleanSource":  "\u0026GAMRole.Load(\u0026RoleId)\n\t\u0026AppId = \u0026ApplicationId\n\t\u0026PermissionFilter.ApplicationId = \u0026AppId\n\t\u0026PermissionFilter.Name\t\t\t= \u0026FilName\n\t\u0026PermissionFilter.AccessType.FromString(\u0026PermissionAccessType)\n\t\u0026PermissionFilter.Inherited.FromString(\u0026BoolenFilter)\n\t\u0026GamPermissions = \u0026GAMRole.GetUnassignedPermissions(\u0026PermissionFilter, \u0026Errors) \n\tif \u0026GamPermissions.count=0\n\t\t\u0026GridPageCount=0\n\telse\n\t\t\u0026GridPageCount=(\u0026GamPermissions.count/Page.Rows)+1\n\tendif\n\t\u0026GridRecordCount = \u0026GamPermissions.Count\n\tIf not \u0026AppId.IsEmpty()\n\t\tFor \u0026Permission in \u0026GamPermissions\n\t\t\t\u0026Select\t= False\n\t\t\t\u0026Id\t\t= \u0026Permission.GUID\n\t\t\t\u0026Name \t= \u0026Permission.Name\n\t\t\t\u0026Dsc \t= \u0026Permission.Description\n\t/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */\n\t//this code should be inside the For Each used to load the data\n\t\n\t//Sample conditions to be added manually:\n\t//Where \u003cAttribute\u003e like \u0026FilName when not \u0026FilName.IsEmpty()\n\t//Where \u003cAttribute\u003e = \u0026PermissionAccessType when not \u0026PermissionAccessType.IsEmpty()\n\t//Where \u003cAttribute\u003e = \u0026BoolenFilter when not \u0026BoolenFilter.IsEmpty()\n\t\n\t\u0026Name.Link = Link(\"GAMAppPermissionEntry\", GAMAPiMode.Display, \u0026ApplicationId, \u0026Id)\n\t/* Generated by DVelop Work With Plus Pattern [End] - Do not change */\n\t\t\tGrid.Load()\n\t\tEndFor\n\tEndif"
