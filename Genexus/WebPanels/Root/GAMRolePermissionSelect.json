                              "cleanSource":  "If \u0026RoleId.IsEmpty() or \u0026ApplicationId.IsEmpty()\n\t\treturn\n\tEndif\n\t/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */\n\tGrid.Rows = Page.Rows\n\tGrid_Empowerer.GridInternalName = Grid.InternalName\n\tIf \u0026HTTPRequest.Method = HttpMethod.Get\n\t\tDo \u0027LoadSavedFilters\u0027\n\tEndIf\n\tForm.Caption = \u0027WWP_GAM_SelectPermissionsRole\u0027\n\tDo \u0027LoadGridState\u0027\n\tGridPaginationBar.RowsPerPageSelectedValue = Grid.Rows\n\t/* Generated by DVelop Work With Plus Pattern [End] - Do not change */\n\t\u0026GAMRole.Load(\u0026RoleId)\n\t\u0026GAMApplication.Load(\u0026ApplicationId)\n\tForm.Caption = Format(\"WWP_GAM_AddPermissionsToRole\", \u0026GAMRole.Name.Trim(), \u0026GAMApplication.Name.Trim())"
