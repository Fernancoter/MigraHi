                              "cleanSource":  "Form.Backcolor = rgb(238,238,238)\n\tLayoutMainTable.Class = ThemeClass:MainContainer\n\t\n\t\u0026Password.IsPassword = true\n\tTableError.Visible = False\n\t\n\t//Mark required User Data //////////////\n\t\u0026Repository = GAMRepository.Get()\n\t/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */\n\tDo \u0027AttributesSecurityCode\u0027\n\t/* Generated by DVelop Work With Plus Pattern [End] - Do not change */\n\tTableError.Visible = false"
                          },
                          {
                              "blockName":  "Enter",
                              "blockType":  "Event",
                              "rawSource":  "(Extracted from full RTF)",
                              "cleanSource":  "Do \u0027CheckRequiredFields\u0027\n\tif \u0026CheckRequiredFieldsResult\n\t\t\u0026Repository = GAMRepository.Get()\n\t\tIf \u0026Password = \u0026PasswordConf\n\t\t\t\u0026User.Name\t\t\t= \u0026Name\n\t\t\t\u0026User.EMail\t\t\t= \u0026EMail\n\t\t\t\u0026User.FirstName\t\t= \u0026FirstName\n\t\t\t\u0026User.LastName\t\t= \u0026LastName\t\t\n\t\t\t\u0026User.Birthday\t\t= \u0026Birthday\n\t\t\t\u0026User.Gender.FromString(\u0026Gender)\n\t\t\t\u0026User.Password\t\t= \u0026Password\n\t\t\t\u0026User.Save()\n\t\t\tIf \u0026User.Success()\n        \n\t\t\t\tCommit\n\t\t\t\tIf \u0026Repository.UserActivationMethod = GeneXusSecurityCommon.GAMUserActivationMethod.Automatic\n\t\t\t\t\t\u0026AdditionalParameter.RememberUserType = \u0026UserRememberMe\n\t\t\t\t\t\u0026LoginOK = GAMRepository.Login(\u0026Name, \u0026Password, \u0026AdditionalParameter, \u0026Errors )\n\t\t\t\t\tIf \u0026LoginOK\n\t\t\t\t\t\tGAMRepository.ApplicationGoHome(GAMInternalGUIDs.AppGAMUserBackend)\n\t\t\t\t\tElse\n\t\t\t\t\t\tDo \u0027DisplayMessages\u0027\n\t\t\t\t\tEndIf\n\t\t\t\tElse\n\t\t\t\t\t\u0026LinkURL = GAMRepository.ApplicationGetAccountActivationURL(\"\")\n\t\t\t\t\tIf \u0026LinkURL.IsEmpty()\n\t\t\t\t\t\t\u0026GAMApplication = GAMApplication.Get()\n\t\t\t\t\t\t\u0026LinkURL = \u0026GAMApplication.Environment.URL.Trim() + GAMActivateUserAccount.Link(\"\")\n\t\t\t\t\t\t\u0026LinkURL+= !\"?%1\"\n\t\t\t\t\tEndif\n\t\t\t\t\tGAMCheckUserActivationMethod(\u0026User.GUID, \u0026LinkURL, \u0026Messages)\n\t\t\t\t\tFor \u0026Message in \u0026Messages\n\t\t\t\t\t\tMsg(\u0026Message.Description)\n\t\t\t\t\tEndFor\t\t\t\t\n\t\t\t\tEndif\n\t\t\tElse\n\t\t\t\t\u0026Errors = \u0026User.GetErrors()\n\t\t\t\tDo \u0027DisplayMessages\u0027\n\t\t\tEndif\n\t\tElse\n\t\t\tMsg(\"WWP_GAM_PasswordNotMatch\")\n\t\tEndif\n\tEndif\n\t/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */\n\t/* Generated by DVelop Work With Plus Pattern [End] - Do not change */"
