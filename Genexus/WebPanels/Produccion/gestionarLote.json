                              "cleanSource":  "\u0026AuditTableName = !\u0027Lote\u0027\n\t/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */\n\t\u0026LoadSuccess = True\n\tIf (\u0026TrnMode = TrnMode.Display)\n\t\tOR (\u0026TrnMode = TrnMode.Insert AND SecGAMIsAuthByFunctionalityKey.Udp(!\u0027lote_Insert\u0027))\n\t\tOR (\u0026TrnMode = TrnMode.Update AND SecGAMIsAuthByFunctionalityKey.Udp(!\u0027lote_Update\u0027))\n\t\tOR (\u0026TrnMode = TrnMode.Delete AND SecGAMIsAuthByFunctionalityKey.Udp(!\u0027lote_Delete\u0027))\n\t\tIf \u0026TrnMode \u003c\u003e TrnMode.Insert\n\t\t\t\u0026Lote.Load(\u0026LoteId)\n\t\t\t\u0026LoadSuccess = \u0026Lote.Success()\n\t\t\tIf not \u0026LoadSuccess\n\t\t\t\t\u0026Messages = \u0026Lote.GetMessages()\n\t\t\t\tDo \u0027Show Messages\u0027\n\t\t\tEndIf\n\t\t\tIf \u0026TrnMode = TrnMode.Display OR \u0026TrnMode = TrnMode.Delete\n\t\t\t\tLote_LoteSiloId.Enabled = False\n\t\t\t\tLote_LoteEmbarque.Enabled = False\n\t\t\t\tLote_LoteConsumido.Enabled = False\n\t\t\t\tLote_LoteFechaRegistro.Enabled = False\n\t\t\t\tLote_LoteKg.Enabled = False\n\t\t\t\tLote_LotePaqueteAditivos.Enabled = False\n\t\t\t\tLote_LoteTipoMaterial.Enabled = False\n\t\t\t\tSilo_SiloEstadoMaterial.Enabled = False\n\t\t\tEndIf\n\t\tEndIf\n\tElse\n\t\t\u0026LoadSuccess = False\n\tEndIf\n\tIf \u0026LoadSuccess\n\t\tIf \u0026TrnMode = TrnMode.Delete\n\t\t\tmsg(\u0027GXM_confdelete\u0027)\n\t\tEndIf\n\tEndIf\n\tDo \u0027AttributesSecurityCode\u0027\n\tLote_LoteId.Visible = False\n\twcAuditoria.Object = AuditHistoryById.Create(\u0026AuditTableName, \u0026LoteId)\n\t/* Generated by DVelop Work With Plus Pattern [End] - Do not change */\n\tDo \u0027ActualizarDatosSilo\u0027"
