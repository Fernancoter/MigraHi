                              "cleanSource":  "\u0026FilterName = \u0026FilterName.Trim()\n\tDo \u0027CheckRequiredFields\u0027\n\tIf \u0026CheckRequiredFieldsResult\n\t\t\u0026GridStateCollection.FromXml(LoadManageFiltersState(\u0026UserKey))\n\t\t\u0026IsNameUnique = True\n\t\tFor \u0026GridStateCollectionItem in \u0026GridStateCollection\n\t\t\tIf \u0026GridStateCollectionItem.Title = \u0026FilterName\n\t\t\t\t\u0026IsNameUnique = False\n\t\t\tEndIf\n\t\tEndFor\n\t\tIf \u0026IsNameUnique\n\t\t\t\u0026GridStateCollectionItem = new()\n\t\t\t\u0026GridStateCollectionItem.Title = \u0026FilterName\n\t\t\t\u0026GridStateCollectionItem.GridStateXML = \u0026Session.Get(\u0026GridStateKey)\n\t\t\t\u0026GridStateCollection.Add(\u0026GridStateCollectionItem, 1)\n\t\t\t\n\t\t\tSaveManageFiltersState(\u0026UserKey, \u0026GridStateCollection.ToXml())\n\t\t\tReturn\n\t\tElse\n\t\t\tMsg(WWPBaseObjects.DVMessageGetBasicNotificationMsg(\u0027\u0027, \u0027Name must be unique\u0027, DVMessageType.error, \u0026FilterName.InternalName, DVMessageBoolean.True, \u0027\u0027))\n\t\tEndIf\t\t\n\tEndIf"
                          },
