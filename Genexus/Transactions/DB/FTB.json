                              "cleanSource":  "if(\u0026Mode = trnmode.Update)\n\t\tUpdateFTB.Call()\n\tendif\n\t/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */\n\tLoadWWPContext.Call(\u0026WWPContext)\n\t\u0026TrnContext.FromXml(\u0026WebSession.Get(!\"TrnContext\"))\n\tIf (\u0026TrnContext.TransactionName = \u0026Pgmname and \u0026Mode = TrnMode.Insert)\n\t\tFor \u0026TrnContextAtt in \u0026TrnContext.Attributes\n\t\t\tDo Case\n\t\t\t\t// When inserting with instantiated BudgetCustomer\n\t\t\t\tCase \u0026TrnContextAtt.AttributeName = !\"BudgetCustomer\"\n\t\t\t\t\t\u0026Insert_BudgetCustomer.FromString(\u0026TrnContextAtt.AttributeValue)\n\t\t\t\t// When inserting with instantiated TFBRemissionDoc\n\t\t\t\tCase \u0026TrnContextAtt.AttributeName = !\"TFBRemissionDoc\"\n\t\t\t\t\t\u0026Insert_TFBRemissionDoc.FromString(\u0026TrnContextAtt.AttributeValue)\n\t\t\t\t// When inserting with instantiated FTBOrderDoc\n\t\t\t\tCase \u0026TrnContextAtt.AttributeName = !\"FTBOrderDoc\"\n\t\t\t\t\t\u0026Insert_FTBOrderDoc.FromString(\u0026TrnContextAtt.AttributeValue)\n\t\t\t\t// When inserting with instantiated FTBOrderNumPar\n\t\t\t\tCase \u0026TrnContextAtt.AttributeName = !\"FTBOrderNumPar\"\n\t\t\t\t\t\u0026Insert_FTBOrderNumPar.FromString(\u0026TrnContextAtt.AttributeValue)\n\t\t\t\t// When inserting with instantiated FTBProductNumber\n\t\t\t\tCase \u0026TrnContextAtt.AttributeName = !\"FTBProductNumber\"\n\t\t\t\t\t\u0026Insert_FTBProductNumber.FromString(\u0026TrnContextAtt.AttributeValue)\n\t\t\tEndcase\n\t\tEndfor\n\tEndif\n\t/* Generated by DVelop Work With Plus Pattern [End] - Do not change */"
