                              "rawSource":  "\n\t/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */\n\n\u0026Options = new()\n\u0026OptionsDesc = new()\n\u0026OptionIndexes = new()\nLoadWWPContext.Call(\u0026WWPContext)\n\nDo \u0027LoadGridState\u0027\nDo Case\n\tCase \u0026DDOName.ToUpper() = !\u0027DDO_CAUSAINTERRUPCIONNOMBRE\u0027\n\t\tDo \u0027LoadCausaInterrupcionNombreOptions\u0027\nEndCase\n\n\u0026OptionsJson = \u0026Options.ToJson()\n\u0026OptionsDescJson = \u0026OptionsDesc.ToJson()\n\u0026OptionIndexesJson = \u0026OptionIndexes.ToJson()\n\n\t/* Generated by DVelop Work With Plus Pattern [End] - Do not change */\n\n\nSub \u0027LoadGridState\u0027\n\n\t/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */\n\n\t// Load grid state from session.\n\tIf \u0026Session.Get(!\"Reportes.CausaInterrupcionWWGridState\") = !\"\"\n\t\t\u0026GridState.FromXml(LoadGridState.Udp(!\"Reportes.CausaInterrupcionWWGridState\"))\n\tElse\n\t\t\u0026GridState.FromXml(\u0026Session.Get(!\"Reportes.CausaInterrupcionWWGridState\"))\n\tEndif\t\n\n\tFor \u0026GridStateFilterValue in \u0026GridState.FilterValues\n\t\tDo Case\n\t\t\tCase \u0026GridStateFilterValue.Name = !\"FILTERFULLTEXT\"\n\t\t\t\t\u0026FilterFullText.FromString(\u0026GridStateFilterValue.Value)\n\t\t\tCase \u0026GridStateFilterValue.Name = !\"TFCAUSAINTERRUPCIONNOMBRE\"\n\t\t\t\t\u0026TFCausaInterrupcionNombre.FromString(\u0026GridStateFilterValue.Value)\n\t\t\tCase \u0026GridStateFilterValue.Name = !\"TFCAUSAINTERRUPCIONNOMBRE_SEL\"\n\t\t\t\t\u0026TFCausaInterrupcionNombre_Sel.FromString(\u0026GridStateFilterValue.Value)\n\t\t\tCase \u0026GridStateFilterValue.Name = !\"TFCAUSAINTERRUPCIONPRENSA_SEL\"\n\t\t\t\t\u0026TFCausaInterrupcionPrensa_Sel.FromString(\u0026GridStateFilterValue.Value)\n\t\t\tCase \u0026GridStateFilterValue.Name = !\"TFCAUSAINTERRUPCIONEXTRUSORA_SEL\"\n\t\t\t\t\u0026TFCausaInterrupcionExtrusora_Sel.FromString(\u0026GridStateFilterValue.Value)\n\t\tEndCase\n\tEndFor\n\n\t/* Generated by DVelop Work With Plus Pattern [End] - Do not change */\n\nEndSub\n\nSub \u0027LoadCausaInterrupcionNombreOptions\u0027\n\n\t/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */\n\n\t\u0026TFCausaInterrupcionNombre = \u0026SearchTxt\n\t\u0026TFCausaInterrupcionNombre_Sel.SetEmpty()\n\tFor Each CausaInterrupcion\n\t\tOrder CausaInterrupcionNombre\n\t\tusing CausaInterrupcionWWDS(\u0026FilterFullText, \u0026TFCausaInterrupcionNombre, \u0026TFCausaInterrupcionNombre_Sel, \u0026TFCausaInterrupcionPrensa_Sel, \u0026TFCausaInterrupcionExtrusora_Sel)\n\n\t\t\u0026count = 0\n\t\tFor Each CausaInterrupcion\n\t\t\tOrder CausaInterrupcionNombre\n\t\t\t\u0026count += 1\n\t\tEndFor\n\t\tIf not CausaInterrupcionNombre.IsEmpty()\n\t\t\t\u0026Option = CausaInterrupcionNombre\n\t\t\t\n\t\t\t\u0026Options.Add(\u0026Option)\n\t\t\t\u0026OptionIndexes.Add(trim(\u0026count.ToFormattedString()))\n\t\tEndIf\n\t\tIf \u0026Options.Count = 50\n\t\t\tExit\n\t\tEndIf\n\tEndFor\n\n\t/* Generated by DVelop Work With Plus Pattern [End] - Do not change */\n\nEndSub\n\n",
