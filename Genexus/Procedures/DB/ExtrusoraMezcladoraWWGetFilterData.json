romString(\u0026GridStateFilterValue.Value)\n\t\t\tCase \u0026GridStateFilterValue.Name = !\"TFEXTRUSORAMEZCLADORAHUSILLOVIRGENMIN\"\n\t\t\t\t\u0026TFExtrusoraMezcladoraHusilloVirgenMin.FromString(\u0026GridStateFilterValue.Value)\n\t\t\t\t\u0026TFExtrusoraMezcladoraHusilloVirgenMin_To.FromString(\u0026GridStateFilterValue.ValueTo)\n\t\t\tCase \u0026GridStateFilterValue.Name = !\"TFEXTRUSORAMEZCLADORAHUSILLOVIRGENMAX\"\n\t\t\t\t\u0026TFExtrusoraMezcladoraHusilloVirgenMax.FromString(\u0026GridStateFilterValue.Value)\n\t\t\t\t\u0026TFExtrusoraMezcladoraHusilloVirgenMax_To.FromString(\u0026GridStateFilterValue.ValueTo)\n\t\t\tCase \u0026GridStateFilterValue.Name = !\"TFEXTRUSORAMEZCLADORAHUSILLOMOLIDOMIN\"\n\t\t\t\t\u0026TFExtrusoraMezcladoraHusilloMolidoMin.FromString(\u0026GridStateFilterValue.Value)\n\t\t\t\t\u0026TFExtrusoraMezcladoraHusilloMolidoMin_To.FromString(\u0026GridStateFilterValue.ValueTo)\n\t\t\tCase \u0026GridStateFilterValue.Name = !\"TFEXTRUSORAMEZCLADORAHUSILLOMOLIDOMAX\"\n\t\t\t\t\u0026TFExtrusoraMezcladoraHusilloMolidoMax.FromString(\u0026GridStateFilterValue.Value)\n\t\t\t\t\u0026TFExtrusoraMezcladoraHusilloMolidoMax_To.FromString(\u0026GridStateFilterValue.ValueTo)\n\t\t\tCase \u0026GridStateFilterValue.Name = !\"TFEXTRUSORAMEZCLADORAKGVIRGEN\"\n\t\t\t\t\u0026TFExtrusoraMezcladoraKgVirgen.FromString(\u0026GridStateFilterValue.Value)\n\t\t\t\t\u0026TFExtrusoraMezcladoraKgVirgen_To.FromString(\u0026GridStateFilterValue.ValueTo)\n\t\t\tCase \u0026GridStateFilterValue.Name = !\"TFEXTRUSORAMEZCLADORAKGMOLIDO\"\n\t\t\t\t\u0026TFExtrusoraMezcladoraKgMolido.FromString(\u0026GridStateFilterValue.Value)\n\t\t\t\t\u0026TFExtrusoraMezcladoraKgMolido_To.FromString(\u0026GridStateFilterValue.ValueTo)\n\t\tEndCase\n\tEndFor\n\n\t/* Generated by DVelop Work With Plus Pattern [End] - Do not change */\n\nEndSub\n\nSub \u0027LoadExtrusoraNombreOptions\u0027\n\n\t/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */\n\n\t\u0026TFExtrusoraNombre = 