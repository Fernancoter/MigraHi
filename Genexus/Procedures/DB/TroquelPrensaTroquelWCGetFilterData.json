                              "rawSource":  "\n\t/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */\n\n\u0026Options = new()\n\u0026OptionsDesc = new()\n\u0026OptionIndexes = new()\nLoadWWPContext.Call(\u0026WWPContext)\n\nDo \u0027LoadGridState\u0027\nDo Case\n\tCase \u0026DDOName.ToUpper() = !\u0027DDO_PRENSANOMBRE\u0027\n\t\tDo \u0027LoadPrensaNombreOptions\u0027\nEndCase\n\n\u0026OptionsJson = \u0026Options.ToJson()\n\u0026OptionsDescJson = \u0026OptionsDesc.ToJson()\n\u0026OptionIndexesJson = \u0026OptionIndexes.ToJson()\n\n\t/* Generated by DVelop Work With Plus Pattern [End] - Do not change */\n\n\nSub \u0027LoadGridState\u0027\n\n\t/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */\n\n\t// Load grid state from session.\n\tIf \u0026Session.Get(!\"DB.TroquelPrensaTroquelWCGridState\") = !\"\"\n\t\t\u0026GridState.FromXml(LoadGridState.Udp(!\"DB.TroquelPrensaTroquelWCGridState\"))\n\tElse\n\t\t\u0026GridState.FromXml(\u0026Session.Get(!\"DB.TroquelPrensaTroquelWCGridState\"))\n\tEndif\t\n\n\tFor \u0026GridStateFilterValue in \u0026GridState.FilterValues\n\t\tDo Case\n\t\t\tCase \u0026GridStateFilterValue.Name = !\"FILTERFULLTEXT\"\n\t\t\t\t\u0026FilterFullText.FromString(\u0026GridStateFilterValue.Value)\n\t\t\tCase \u0026GridStateFilterValue.Name = !\"TFPRENSANOMBRE\"\n\t\t\t\t\u0026TFPrensaNombre.FromString(\u0026GridStateFilterValue.Value)\n\t\t\tCase \u0026GridStateFilterValue.Name = !\"TFPRENSANOMBRE_SEL\"\n\t\t\t\t\u0026TFPrensaNombre_Sel.FromString(\u0026GridStateFilterValue.Value)\n\t\t\tCase \u0026GridStateFilterValue.Name = !\"PARM_\u0026TROQUELID\"\n\t\t\t\t\u0026TroquelId.FromString(\u0026GridStateFilterValue.Value)\n\t\tEndCase\n\tEndFor\n\n\t/* Generated by DVelop Work With Plus Pattern [End] - Do not change */\n\nEndSub\n\nSub \u0027LoadPrensaNombreOptions\u0027\n\n\t/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */\n\n\t\u0026TFPrensaNombre = \u0026SearchTxt\n\t\u0026TFPrensaNombre_Sel.SetEmpty()\n\tFor Each PrensaTroquel\n\t\tOrder TroquelId, PrensaNombre\n\t\tWhere TroquelId = \u0026TroquelId\n\t\tWhere (PrensaTroquelId.ToString() like !\u0027%\u0027 + \u0026FilterFullText) OR (PrensaId.ToString() like !\u0027%\u0027 + \u0026FilterFullText) OR (PrensaNombre like !\u0027%\u0027 + \u0026FilterFullText) When not \u0026FilterFullText.IsEmpty()\n\t\tWhere PrensaNombre like \u0026TFPrensaNombre when \u0026TFPrensaNombre_Sel.IsEmpty() AND (not \u0026TFPrensaNombre.IsEmpty())\n\t\tWhere PrensaNombre = \u0026TFPrensaNombre_Sel when not \u0026TFPrensaNombre_Sel.IsEmpty()\n\n\t\t\u0026count = 0\n\t\tFor Each PrensaTroquel\n\t\t\tOrder TroquelId, PrensaNombre\n\t\t\t\u0026count += 1\n\t\tEndFor\n\t\tIf not PrensaNombre.IsEmpty()\n\t\t\t\u0026Option = PrensaNombre\n\t\t\t\n\t\t\t\u0026Options.Add(\u0026Option)\n\t\t\t\u0026OptionIndexes.Add(trim(\u0026count.ToFormattedString()))\n\t\tEndIf\n\t\tIf \u0026Options.Count = 50\n\t\t\tExit\n\t\tEndIf\n\tEndFor\n\n\t/* Generated by DVelop Work With Plus Pattern [End] - Do not change */\n\nEndSub\n\n",
