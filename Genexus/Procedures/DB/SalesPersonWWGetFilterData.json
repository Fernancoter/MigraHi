0026TFSalesPersonName_Sel.SetEmpty()\n\tFor Each SalesPerson\n\t\tOrder SalesPersonName\n\t\tusing SalesPersonWWDS(\u0026FilterFullText, \u0026TFSalesPersonName, \u0026TFSalesPersonName_Sel, \u0026TFSalesPersonActive_Sel)\n\n\t\tOption Distinct\n\t\tIf not SalesPersonName.IsEmpty()\n\t\t\t\u0026Option = SalesPersonName\n\t\t\t\n\t\t\t\u0026Options.Add(\u0026Option)\n\t\tEndIf\n\t\tIf \u0026Options.Count = 50\n\t\t\tExit\n\t\tEndIf\n\tEndFor\n\n\t/* Generated by DVelop Work With Plus Pattern [End] - Do not change */\n\nEndSub"
