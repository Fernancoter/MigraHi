                              "blockName":  "Source",
                              "blockType":  "Source",
                              "rawSource":  "\u0026User = GAMUser.Get()\n//Gets last error in the GAM \n\u0026Errors = GAMRepository.GetLastErrors()\nIf \u0026Errors.Count = 0\n\t\u0026User.Name\t\t\t= \u0026UserName\n\t\u0026User.EMail\t\t\t= \u0026EMail\n\t\u0026User.FirstName\t\t= \u0026FirstName\n\t\u0026User.LastName\t\t= \u0026LastName\n\t\u0026isOK = GAMRepository.UpdateUserByKeyToCompleteUserData(\u0026User, \u0026Errors)\n\tIf not \u0026isOK\n\t\t\u0026Messages = GAMConvertErrorsToMessages(\u0026Errors)\n\tendif\nelse\n\t\u0026Messages = GAMConvertErrorsToMessages(\u0026Errors)\nendif\n",
                              "cleanSource":  "\u0026User = GAMUser.Get()\n//Gets last error in the GAM \n\u0026Errors = GAMRepository.GetLastErrors()\nIf \u0026Errors.Count = 0\n\t\u0026User.Name\t\t\t= \u0026UserName\n\t\u0026User.EMail\t\t\t= \u0026EMail\n\t\u0026User.FirstName\t\t= \u0026FirstName\n\t\u0026User.LastName\t\t= \u0026LastName\n\t\u0026isOK = GAMRepository.UpdateUserByKeyToCompleteUserData(\u0026User, \u0026Errors)\n\tIf not \u0026isOK\n\t\t\u0026Messages = GAMConvertErrorsToMessages(\u0026Errors)\n\tendif\nelse\n\t\u0026Messages = GAMConvertErrorsToMessages(\u0026Errors)\nendif"
                          },
                          {
                              "blockName":  "Rules",
                              "blockType":  "Rules",
                              "rawSource":  "Parm(in:\u0026UserGUID, in:\u0026UserName, in:\u0026Email, in:\u0026FirstName, in:\u0026LastName, out:\u0026Messages);\n",
                              "cleanSource":  "Parm(in:\u0026UserGUID, in:\u0026UserName, in:\u0026Email, in:\u0026FirstName, in:\u0026LastName, out:\u0026Messages);"
                          }
