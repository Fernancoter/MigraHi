                              "blockType":  "Source",
                              "rawSource":  "If \u0026UserName.IsEmpty()\n\t\u0026Message.Type = MessageTypes.Error\n\t\u0026Message.Description = \"User name must be entered.\"\n\t\u0026Messages.Add(\u0026Message)\n\tReturn\t\nEndif\n\nIf \u0026Password \u003c\u003e \u0026ConfirmPassword\n\t\u0026Message.Type = GeneXus.MessageTypes.Error\n\t\u0026Message.Description = \"Passwords don\u0027t match.\"\n\t\u0026Messages.Add(\u0026Message)\n\tReturn\nEndif\n\n\u0026User.Name\t\t\t= \u0026UserName\n\u0026User.EMail\t\t\t= \u0026EMail\n\u0026User.FirstName\t\t= \u0026FirstName\n\u0026User.LastName\t\t= \u0026LastName\n\u0026User.Password\t\t= \u0026Password\n\u0026User.Save()\nif \u0026User.Success()\n\tCommit\n\t\u0026LinkURL = GAMRepository.ApplicationGetAccountActivationURL(\"\")\n\tGAMCheckUserActivationMethod(\u0026User.GUID, \u0026LinkURL, \u0026Messages)\nelse\n\t\u0026Errors = \u0026User.GetErrors()\n\t\u0026Messages = GAMConvertErrorsToMessages(\u0026Errors)\nendif\n\n",
                              "cleanSource":  "If \u0026UserName.IsEmpty()\n\t\u0026Message.Type = MessageTypes.Error\n\t\u0026Message.Description = \"User name must be entered.\"\n\t\u0026Messages.Add(\u0026Message)\n\tReturn\t\nEndif\n\nIf \u0026Password \u003c\u003e \u0026ConfirmPassword\n\t\u0026Message.Type = GeneXus.MessageTypes.Error\n\t\u0026Message.Description = \"Passwords don\u0027t match.\"\n\t\u0026Messages.Add(\u0026Message)\n\tReturn\nEndif\n\n\u0026User.Name\t\t\t= \u0026UserName\n\u0026User.EMail\t\t\t= \u0026EMail\n\u0026User.FirstName\t\t= \u0026FirstName\n\u0026User.LastName\t\t= \u0026LastName\n\u0026User.Password\t\t= \u0026Password\n\u0026User.Save()\nif \u0026User.Success()\n\tCommit\n\t\u0026LinkURL = GAMRepository.ApplicationGetAccountActivationURL(\"\")\n\tGAMCheckUserActivationMethod(\u0026User.GUID, \u0026LinkURL, \u0026Messages)\nelse\n\t\u0026Errors = \u0026User.GetErrors()\n\t\u0026Messages = GAMConvertErrorsToMessages(\u0026Errors)\nendif"
