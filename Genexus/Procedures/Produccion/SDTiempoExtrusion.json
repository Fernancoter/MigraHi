                              "blockName":  "Source",
                              "blockType":  "Source",
                              "rawSource":  "\u0026SgteExtrusionId = Produccion.SgteTurnoExtrusora.Udp(\u0026ExtrusionId)\n\nif(\u0026SgteExtrusionId \u003e 0)\n\t\u0026SgteExtrusion.Load(\u0026SgteExtrusionId)\n\t\u0026SgteExtrusionFecha = \u0026SgteExtrusion.ExtrusionFecha\n\t\u0026Tiempo = \u0026SgteExtrusionFecha.Difference(\u0026IniciaProceso)\n\t\u0026TiempoMin = (\u0026Tiempo/60) - 60\nelse\n\t\u0026TiempoMin = Produccion.SDTiempoLaboral.Udp()\nendif\n",
                              "cleanSource":  "\u0026SgteExtrusionId = Produccion.SgteTurnoExtrusora.Udp(\u0026ExtrusionId)\n\nif(\u0026SgteExtrusionId \u003e 0)\n\t\u0026SgteExtrusion.Load(\u0026SgteExtrusionId)\n\t\u0026SgteExtrusionFecha = \u0026SgteExtrusion.ExtrusionFecha\n\t\u0026Tiempo = \u0026SgteExtrusionFecha.Difference(\u0026IniciaProceso)\n\t\u0026TiempoMin = (\u0026Tiempo/60) - 60\nelse\n\t\u0026TiempoMin = Produccion.SDTiempoLaboral.Udp()\nendif"
                          },
                          {
                              "blockName":  "Rules",
                              "blockType":  "Rules",
                              "rawSource":  "parm(in:\u0026ExtrusionId, in:\u0026IniciaProceso, out:\u0026TiempoMin);\n",
                              "cleanSource":  "parm(in:\u0026ExtrusionId, in:\u0026IniciaProceso, out:\u0026TiempoMin);"
                          }
                      ],
