                              "blockName":  "Source",
                              "blockType":  "Source",
                              "rawSource":  "\n\tfor each DB.Carrera\n\t\twhere CarreraId \u003e 0\n\t\twhere CarreraEstado = EstadoCarrera.EnProceso\n\t\t\u0026CarreraId = WWPBaseObjects.CarreraId\n\t\tSetEstadoCarrera.Call(\u0026CarreraId, EstadoCarrera.Terminada)\n\t\tdo \u0027CarretesEnRevision\u0027\n\t\tSDPAddNotification(\u0026CarreraId, NotificacionTipo.Carrera)\n\tendfor\n\n        Sub \u0027CarretesEnRevision\u0027\n\t\tfor each DB.Carrete\n\t\t\twhere CarreteId \u003e 0\n\t\t\twhere CarreteCarreraId = \u0026CarreraId\n\t\t\t\u0026CarreteId = CarreteId\n\t\t\tSetEstadoCarrete.Call(\u0026CarreteId, EstadoCarrete.EnRevision, false)\n\t\tendfor\n\tEndSub\n",
                              "cleanSource":  "\n\tfor each DB.Carrera\n\t\twhere CarreraId \u003e 0\n\t\twhere CarreraEstado = EstadoCarrera.EnProceso\n\t\t\u0026CarreraId = WWPBaseObjects.CarreraId\n\t\tSetEstadoCarrera.Call(\u0026CarreraId, EstadoCarrera.Terminada)\n\t\tdo \u0027CarretesEnRevision\u0027\n\t\tSDPAddNotification(\u0026CarreraId, NotificacionTipo.Carrera)\n\tendfor\n\n        Sub \u0027CarretesEnRevision\u0027\n\t\tfor each DB.Carrete\n\t\t\twhere CarreteId \u003e 0\n\t\t\twhere CarreteCarreraId = \u0026CarreraId\n\t\t\t\u0026CarreteId = CarreteId\n\t\t\tSetEstadoCarrete.Call(\u0026CarreteId, EstadoCarrete.EnRevision, false)\n\t\tendfor\n\tEndSub"
                          }
                      ],
