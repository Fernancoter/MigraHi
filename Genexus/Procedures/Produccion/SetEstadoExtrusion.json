                              "blockName":  "Source",
                              "blockType":  "Source",
                              "rawSource":  "         \n\t \u0026Extrusion.Load(\u0026ExtrusionId)\n\t \u0026Extrusion.ExtrusionEstado = \u0026ExtrusionEstado\n\t \n\t Do Case\n\t\t Case \u0026ExtrusionEstado = Produccion.EstadoExtrusion.EnProceso\n\t\t         \u0026Extrusion.ExtrusionHoraIniciaProceso = Now()\n\t\t Case \u0026ExtrusionEstado = EstadoExtrusion.Terminada\n\t\t         \u0026Extrusion.ExtrusionHoraFinProceso = Now()\n\t EndCase\n\t \n\t \u0026Extrusion.Save()\n\t \n\t if(\u0026Extrusion.Success())\n\t\t commit\n         endif\n",
                              "cleanSource":  "         \n\t \u0026Extrusion.Load(\u0026ExtrusionId)\n\t \u0026Extrusion.ExtrusionEstado = \u0026ExtrusionEstado\n\t \n\t Do Case\n\t\t Case \u0026ExtrusionEstado = Produccion.EstadoExtrusion.EnProceso\n\t\t         \u0026Extrusion.ExtrusionHoraIniciaProceso = Now()\n\t\t Case \u0026ExtrusionEstado = EstadoExtrusion.Terminada\n\t\t         \u0026Extrusion.ExtrusionHoraFinProceso = Now()\n\t EndCase\n\t \n\t \u0026Extrusion.Save()\n\t \n\t if(\u0026Extrusion.Success())\n\t\t commit\n         endif"
                          },
                          {
                              "blockName":  "Rules",
                              "blockType":  "Rules",
                              "rawSource":  "parm(in:\u0026ExtrusionId, in:\u0026ExtrusionEstado);\n",
                              "cleanSource":  "parm(in:\u0026ExtrusionId, in:\u0026ExtrusionEstado);"
                          }
