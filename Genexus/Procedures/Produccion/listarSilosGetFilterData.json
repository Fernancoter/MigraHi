                              "rawSource":  "\n\t/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */\n\n\u0026Options = new()\n\u0026OptionsDesc = new()\n\u0026OptionIndexes = new()\nLoadWWPContext.Call(\u0026WWPContext)\n\nDo \u0027LoadGridState\u0027\nDo Case\n\tCase \u0026DDOName.ToUpper() = !\u0027DDO_SILONOMBRE\u0027\n\t\tDo \u0027LoadSiloNombreOptions\u0027\nEndCase\n\n\u0026OptionsJson = \u0026Options.ToJson()\n\u0026OptionsDescJson = \u0026OptionsDesc.ToJson()\n\u0026OptionIndexesJson = \u0026OptionIndexes.ToJson()\n\n\t/* Generated by DVelop Work With Plus Pattern [End] - Do not change */\n\n\nSub \u0027LoadGridState\u0027\n\n\t/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */\n\n\t// Load grid state from session.\n\tIf \u0026Session.Get(!\"Produccion.listarSilosGridState\") = !\"\"\n\t\t\u0026GridState.FromXml(LoadGridState.Udp(!\"Produccion.listarSilosGridState\"))\n\tElse\n\t\t\u0026GridState.FromXml(\u0026Session.Get(!\"Produccion.listarSilosGridState\"))\n\tEndif\t\n\n\tFor \u0026GridStateFilterValue in \u0026GridState.FilterValues\n\t\tDo Case\n\t\t\tCase \u0026GridStateFilterValue.Name = !\"FILTERFULLTEXT\"\n\t\t\t\t\u0026FilterFullText.FromString(\u0026GridStateFilterValue.Value)\n\t\t\tCase \u0026GridStateFilterValue.Name = !\"TFSILONOMBRE\"\n\t\t\t\t\u0026TFSiloNombre.FromString(\u0026GridStateFilterValue.Value)\n\t\t\tCase \u0026GridStateFilterValue.Name = !\"TFSILONOMBRE_SEL\"\n\t\t\t\t\u0026TFSiloNombre_Sel.FromString(\u0026GridStateFilterValue.Value)\n\t\t\tCase \u0026GridStateFilterValue.Name = !\"TFSILOCAPACIDAD\"\n\t\t\t\t\u0026TFSiloCapacidad.FromString(\u0026GridStateFilterValue.Value)\n\t\t\t\t\u0026TFSiloCapacidad_To.FromString(\u0026GridStateFilterValue.ValueTo)\n\t\t\tCase \u0026GridStateFilterValue.Name = !\"TFSILOKGMINIMO\"\n\t\t\t\t\u0026TFSiloKgMinimo.FromString(\u0026GridStateFilterValue.Value)\n\t\t\t\t\u0026TFSiloKgMinimo_To.FromString(\u0026GridStateFilterValue.ValueTo)\n\t\t\tCase \u0026GridStateFilterValue.Name = !\"TFSILOKGMAXIMO\"\n\t\t\t\t\u0026TFSiloKgMaximo.FromString(\u0026GridStateFilterValue.Value)\n\t\t\t\t\u0026TFSiloKgMaximo_To.FromString(\u0026GridStateFilterValue.ValueTo)\n\t\t\tCase \u0026GridStateFilterValue.Name = !\"TFSILOESTADOMATERIAL_SEL\"\n\t\t\t\t\u0026TFSiloEstadoMaterial_SelsJson = \u0026GridStateFilterValue.Value\n\t\t\t\t\u0026TFSiloEstadoMaterial_Sels.FromJson(\u0026TFSiloEstadoMaterial_SelsJson)\n\t\t\tCase \u0026GridStateFilterValue.Name = !\"TFSILOTIPOMATERIAL_SEL\"\n\t\t\t\t\u0026TFSiloTipoMaterial_SelsJson = \u0026GridStateFilterValue.Value\n\t\t\t\t\u0026TFSiloTipoMaterial_Sels.FromJson(\u0026TFSiloTipoMaterial_SelsJson)\n\t\t\tCase \u0026GridStateFilterValue.Name = !\"TFSILOACTIVO_SEL\"\n\t\t\t\t\u0026TFSiloActivo_Sel.FromString(\u0026GridStateFilterValue.Value)\n\t\tEndCase\n\tEndFor\n\n\t/* Generated by DVelop Work With Plus Pattern [End] - Do not change */\n\nEndSub\n\nSub \u0027LoadSiloNombreOptions\u0027\n\n\t/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */\n\n\t\u0026TFSiloNombre = \u0026SearchTxt\n\t\u0026TFSiloNombre_Sel.SetEmpty()\n\tFor Each DB.Silo\n\t\tOrder SiloNombre\n\t\tusing listarSilosDS(\u0026FilterFullText, \u0026TFSiloNombre, \u0026TFSiloNombre_Sel, \u0026TFSiloCapacidad, \u0026TFSiloCapacidad_To, \u0026TFSiloKgMinimo\n\t\t\t\t\t, \u0026TFSiloKgMinimo_To, \u0026TFSiloKgMaximo, \u0026TFSiloKgMaximo_To, \u0026TFSiloEstadoMaterial_Sels, \u0026TFSiloTipoMaterial_Sels, \u0026TFSiloActivo_Sel)\n\n\t\t\u0026count = 0\n\t\tFor Each DB.Silo\n\t\t\tOrder SiloNombre\n\t\t\t\u0026count += 1\n\t\tEndFor\n\t\tIf not SiloNombre.IsEmpty()\n\t\t\t\u0026Option = SiloNombre\n\t\t\t\n\t\t\t\u0026Options.Add(\u0026Option)\n\t\t\t\u0026OptionIndexes.Add(trim(\u0026count.ToFormattedString()))\n\t\tEndIf\n\t\tIf \u0026Options.Count = 50\n\t\t\tExit\n\t\tEndIf\n\tEndFor\n\n\t/* Generated by DVelop Work With Plus Pattern [End] - Do not change */\n\nEndSub\n\n",
                              "cleanSource":  "\n\t/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */\n\n\u0026Options = new()\n\u0026OptionsDesc = new()\n\u0026OptionIndexes = new()\nLoadWWPContext.Call(\u0026WWPContext)\n\nDo \u0027LoadGridState\u0027\nDo Case\n\tCase \u0026DDOName.ToUpper() = !\u0027DDO_SILONOMBRE\u0027\n\t\tDo \u0027LoadSiloNombreOptions\u0027\nEndCase\n\n\u0026OptionsJson = \u0026Options.ToJson()\n\u0026OptionsDescJson = \u0026OptionsDesc.ToJson()\n\u0026OptionIndexesJson = \u0026OptionIndexes.ToJson()\n\n\t/* Generated by DVelop Work With Plus Pattern [End] - Do not change */\n\n\nSub \u0027LoadGridState\u0027\n\n\t/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */\n\n\t// Load grid state from session.\n\tIf \u0026Session.Get(!\"Produccion.listarSilosGridState\") = !\"\"\n\t\t\u0026GridState.FromXml(LoadGridState.Udp(!\"Produccion.listarSilosGridState\"))\n\tElse\n\t\t\u0026GridState.FromXml(\u0026Session.Get(!\"Produccion.listarSilosGridState\"))\n\tEndif\t\n\n\tFor \u0026GridStateFilterValue in \u0026GridState.FilterValues\n\t\tDo Case\n\t\t\tCase \u0026GridStateFilterValue.Name = !\"FILTERFULLTEXT\"\n\t\t\t\t\u0026FilterFullText.FromString(\u0026GridStateFilterValue.Value)\n\t\t\tCase \u0026GridStateFilterValue.Name = !\"TFSILONOMBRE\"\n\t\t\t\t\u0026TFSiloNombre.FromString(\u0026GridStateFilterValue.Value)\n\t\t\tCase \u0026GridStateFilterValue.Name = !\"TFSILONOMBRE_SEL\"\n\t\t\t\t\u0026TFSiloNombre_Sel.FromString(\u0026GridStateFilterValue.Value)\n\t\t\tCase \u0026GridStateFilterValue.Name = !\"TFSILOCAPACIDAD\"\n\t\t\t\t\u0026TFSiloCapacidad.FromString(\u0026GridStateFilterValue.Value)\n\t\t\t\t\u0026TFSiloCapacidad_To.FromString(\u0026GridStateFilterValue.ValueTo)\n\t\t\tCase \u0026GridStateFilterValue.Name = !\"TFSILOKGMINIMO\"\n\t\t\t\t\u0026TFSiloKgMinimo.FromString(\u0026GridStateFilterValue.Value)\n\t\t\t\t\u0026TFSiloKgMinimo_To.FromString(\u0026GridStateFilterValue.ValueTo)\n\t\t\tCase \u0026GridStateFilterValue.Name = !\"TFSILOKGMAXIMO\"\n\t\t\t\t\u0026TFSiloKgMaximo.FromString(\u0026GridStateFilterValue.Value)\n\t\t\t\t\u0026TFSiloKgMaximo_To.FromString(\u0026GridStateFilterValue.ValueTo)\n\t\t\tCase \u0026GridStateFilterValue.Name = !\"TFSILOESTADOMATERIAL_SEL\"\n\t\t\t\t\u0026TFSiloEstadoMaterial_SelsJson = \u0026GridStateFilterValue.Value\n\t\t\t\t\u0026TFSiloEstadoMaterial_Sels.FromJson(\u0026TFSiloEstadoMaterial_SelsJson)\n\t\t\tCase \u0026GridStateFilterValue.Name = !\"TFSILOTIPOMATERIAL_SEL\"\n\t\t\t\t\u0026TFSiloTipoMaterial_SelsJson = \u0026GridStateFilterValue.Value\n\t\t\t\t\u0026TFSiloTipoMaterial_Sels.FromJson(\u0026TFSiloTipoMaterial_SelsJson)\n\t\t\tCase \u0026GridStateFilterValue.Name = !\"TFSILOACTIVO_SEL\"\n\t\t\t\t\u0026TFSiloActivo_Sel.FromString(\u0026GridStateFilterValue.Value)\n\t\tEndCase\n\tEndFor\n\n\t/* Generated by DVelop Work With Plus Pattern [End] - Do not change */\n\nEndSub\n\nSub \u0027LoadSiloNombreOptions\u0027\n\n\t/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */\n\n\t\u0026TFSiloNombre = \u0026SearchTxt\n\t\u0026TFSiloNombre_Sel.SetEmpty()\n\tFor Each DB.Silo\n\t\tOrder SiloNombre\n\t\tusing listarSilosDS(\u0026FilterFullText, \u0026TFSiloNombre, \u0026TFSiloNombre_Sel, \u0026TFSiloCapacidad, \u0026TFSiloCapacidad_To, \u0026TFSiloKgMinimo\n\t\t\t\t\t, \u0026TFSiloKgMinimo_To, \u0026TFSiloKgMaximo, \u0026TFSiloKgMaximo_To, \u0026TFSiloEstadoMaterial_Sels, \u0026TFSiloTipoMaterial_Sels, \u0026TFSiloActivo_Sel)\n\n\t\t\u0026count = 0\n\t\tFor Each DB.Silo\n\t\t\tOrder SiloNombre\n\t\t\t\u0026count += 1\n\t\tEndFor\n\t\tIf not SiloNombre.IsEmpty()\n\t\t\t\u0026Option = SiloNombre\n\t\t\t\n\t\t\t\u0026Options.Add(\u0026Option)\n\t\t\t\u0026OptionIndexes.Add(trim(\u0026count.ToFormattedString()))\n\t\tEndIf\n\t\tIf \u0026Options.Count = 50\n\t\t\tExit\n\t\tEndIf\n\tEndFor\n\n\t/* Generated by DVelop Work With Plus Pattern [End] - Do not change */\n\nEndSub"
