    "businessLogic":  [
                          {
                              "blockName":  "Source",
                              "blockType":  "Source",
                              "rawSource":  "\n\t\u0026IntEnCurso = 0\n\tDo Case\n\t\tCase \u0026Maquina = AreaMaquina.Extrusora\n\t\t\tFor each DB.ExtrusionInterrupcion order (ExtrusionId)\n\t\t\t\twhere ExtrusionId \u003e 0\n\t\t\t\twhere ExtrusionId = \u0026ProcesoId\n\t\t\t\twhere InterrupcionId \u003e 0\n\t\t\t\twhere InterrupcionConcluida = False\n\t\t\t\t\u0026HoraInicio = InterrupcionHoraInicio\n\t\t\t\t\u0026IntEnCurso = InterrupcionId\n\t\t\t\tExit\n\t\t\tEndFor\n\n\t\tCase \u0026Maquina = AreaMaquina.Prensa\n\t\t\tFor each DB.PrensadoInterrupcion order (PrensadoId)\n\t\t\t\twhere PrensadoId \u003e 0\n\t\t\t\twhere PrensadoId = \u0026ProcesoId\n\t\t\t\twhere InterrupcionId \u003e 0\n\t\t\t\twhere InterrupcionConcluida = False\n\t\t\t\t\u0026HoraInicio = InterrupcionHoraInicio\n\t\t\t\t\u0026IntEnCurso = InterrupcionId\n\t\t\t\tExit\n\t\t\tEndFor\n\tEndCase\n",
                              "cleanSource":  "\n\t\u0026IntEnCurso = 0\n\tDo Case\n\t\tCase \u0026Maquina = AreaMaquina.Extrusora\n\t\t\tFor each DB.ExtrusionInterrupcion order (ExtrusionId)\n\t\t\t\twhere ExtrusionId \u003e 0\n\t\t\t\twhere ExtrusionId = \u0026ProcesoId\n\t\t\t\twhere InterrupcionId \u003e 0\n\t\t\t\twhere InterrupcionConcluida = False\n\t\t\t\t\u0026HoraInicio = InterrupcionHoraInicio\n\t\t\t\t\u0026IntEnCurso = InterrupcionId\n\t\t\t\tExit\n\t\t\tEndFor\n\n\t\tCase \u0026Maquina = AreaMaquina.Prensa\n\t\t\tFor each DB.PrensadoInterrupcion order (PrensadoId)\n\t\t\t\twhere PrensadoId \u003e 0\n\t\t\t\twhere PrensadoId = \u0026ProcesoId\n\t\t\t\twhere InterrupcionId \u003e 0\n\t\t\t\twhere InterrupcionConcluida = False\n\t\t\t\t\u0026HoraInicio = InterrupcionHoraInicio\n\t\t\t\t\u0026IntEnCurso = InterrupcionId\n\t\t\t\tExit\n\t\t\tEndFor\n\tEndCase"
                          },
                          {
                              "blockName":  "Rules",
                              "blockType":  "Rules",
                              "rawSource":  "parm(in:\u0026Maquina, in:\u0026ProcesoId, out:\u0026IntEnCurso);\n",
                              "cleanSource":  "parm(in:\u0026Maquina, in:\u0026ProcesoId, out:\u0026IntEnCurso);"
                          }
                      ],
