                              "blockName":  "Source",
                              "blockType":  "Source",
                              "rawSource":  "        \n\t\u0026Extrusion.Load(\u0026ExtrusionId)\n\t\u0026ExtrusoraId = \u0026Extrusion.ExtrusionExtrusoraId\n\t\n\tfor each DB.Bobina\n\t\twhere BobinaId \u003e 0\n\t\twhere ExtrusionId = \u0026ExtrusionId\n\t\twhere BobinaEstado = EstadoBobina.EnProceso\n\t\t\u0026BobinaId = BobinaId\n\t        \n\t\tSetEstadoBobina.Call(\u0026BobinaId, EstadoBobina.Pausada)\n\t\t\n\t\tdo \u0027ExtrusoraBobina\u0027\n\tEndfor\n\n        Sub \u0027ExtrusoraBobina\u0027\n\t\t\n\t\t\u0026ExtrusoraBobina = New()\n\t\t\u0026ExtrusoraBobina.BobinaId = \u0026BobinaId\n\t\t\u0026ExtrusoraBobina.ExtrusoraId = \u0026ExtrusoraId\n\t\t\u0026ExtrusoraBobina.Save()\n\t\t\n\t\tif(\u0026ExtrusoraBobina.Success())\n\t\t\tcommit\n\t\tendif\n\tEndSub\n",
                              "cleanSource":  "        \n\t\u0026Extrusion.Load(\u0026ExtrusionId)\n\t\u0026ExtrusoraId = \u0026Extrusion.ExtrusionExtrusoraId\n\t\n\tfor each DB.Bobina\n\t\twhere BobinaId \u003e 0\n\t\twhere ExtrusionId = \u0026ExtrusionId\n\t\twhere BobinaEstado = EstadoBobina.EnProceso\n\t\t\u0026BobinaId = BobinaId\n\t        \n\t\tSetEstadoBobina.Call(\u0026BobinaId, EstadoBobina.Pausada)\n\t\t\n\t\tdo \u0027ExtrusoraBobina\u0027\n\tEndfor\n\n        Sub \u0027ExtrusoraBobina\u0027\n\t\t\n\t\t\u0026ExtrusoraBobina = New()\n\t\t\u0026ExtrusoraBobina.BobinaId = \u0026BobinaId\n\t\t\u0026ExtrusoraBobina.ExtrusoraId = \u0026ExtrusoraId\n\t\t\u0026ExtrusoraBobina.Save()\n\t\t\n\t\tif(\u0026ExtrusoraBobina.Success())\n\t\t\tcommit\n\t\tendif\n\tEndSub"
                          },
