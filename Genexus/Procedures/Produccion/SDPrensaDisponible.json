    "businessLogic":  [
                          {
                              "blockName":  "Source",
                              "blockType":  "Source",
                              "rawSource":  " \n \u0026Disponible = true\n \n for each DB.Prensado\n\t where PrensadoId \u003e 0\n\t where Not PrensadoId = \u0026PrensadoId\n\t where PrensadoPrensaId = \u0026PrensaId\n\t \u0026PrensadoEstado = PrensadoEstado\n\t \n\t if(\u0026PrensadoEstado = EstadoPrensado.EnProceso)\n\t      \u0026Disponible = false\n\t      Exit\n\t endif\n Endfor\n \n",
                              "cleanSource":  " \n \u0026Disponible = true\n \n for each DB.Prensado\n\t where PrensadoId \u003e 0\n\t where Not PrensadoId = \u0026PrensadoId\n\t where PrensadoPrensaId = \u0026PrensaId\n\t \u0026PrensadoEstado = PrensadoEstado\n\t \n\t if(\u0026PrensadoEstado = EstadoPrensado.EnProceso)\n\t      \u0026Disponible = false\n\t      Exit\n\t endif\n Endfor"
                          },
                          {
                              "blockName":  "Rules",
                              "blockType":  "Rules",
                              "rawSource":  "parm(in:\u0026PrensadoId, in:\u0026PrensaId, out:\u0026Disponible);\n",
                              "cleanSource":  "parm(in:\u0026PrensadoId, in:\u0026PrensaId, out:\u0026Disponible);"
                          }
