                              "blockName":  "Source",
                              "blockType":  "Source",
                              "rawSource":  "\u0026SgtePrensadoId = SgteTurnoPrensado.Udp(\u0026PrensadoId)\n\nif(\u0026SgtePrensadoId \u003e 0)\n\t\u0026SgtePrensado.Load(\u0026SgtePrensadoId)\n\t\u0026SgtePrensadoFecha = \u0026SgtePrensado.PrensadoFecha\n\t\u0026Tiempo = \u0026SgtePrensadoFecha.Difference(\u0026IniciaProceso)\n\t\u0026TiempoMin = (\u0026Tiempo/60) - 60\nelse\n\t\u0026TiempoMin = Produccion.SDTiempoLaboral.Udp()\nendif\n",
                              "cleanSource":  "\u0026SgtePrensadoId = SgteTurnoPrensado.Udp(\u0026PrensadoId)\n\nif(\u0026SgtePrensadoId \u003e 0)\n\t\u0026SgtePrensado.Load(\u0026SgtePrensadoId)\n\t\u0026SgtePrensadoFecha = \u0026SgtePrensado.PrensadoFecha\n\t\u0026Tiempo = \u0026SgtePrensadoFecha.Difference(\u0026IniciaProceso)\n\t\u0026TiempoMin = (\u0026Tiempo/60) - 60\nelse\n\t\u0026TiempoMin = Produccion.SDTiempoLaboral.Udp()\nendif"
                          },
                          {
                              "blockName":  "Rules",
                              "blockType":  "Rules",
                              "rawSource":  "parm(in:\u0026PrensadoId, in:\u0026IniciaProceso, out:\u0026TiempoMin);\n",
                              "cleanSource":  "parm(in:\u0026PrensadoId, in:\u0026IniciaProceso, out:\u0026TiempoMin);"
                          }
