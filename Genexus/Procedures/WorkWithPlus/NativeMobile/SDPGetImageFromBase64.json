                              "blockName":  "Source",
                              "blockType":  "Source",
                              "rawSource":  "//\u0026BlobImage.FromBase64String(\u0026ImageBase64)\n//ImageBase64 includes linebreaks and java does not support them\n\n\u0026NewLine = CHR(10)\n\u0026ImageBase64NoLines = StrReplace(\u0026ImageBase64, \u0026NewLine, \"\")\n\u0026BlobImage.FromBase64String(\u0026ImageBase64NoLines) \n\n\u0026CaptureImage = \u0026BlobImage\n\n// You can use \u0026CaptureImage to store the signature in the transaction\n// e.g\n// \u0026Client = new()\n// \u0026Client.ClientSignatureImage = \u0026CaptureImage\n// \u0026Client.Save()\n",
                              "cleanSource":  "//\u0026BlobImage.FromBase64String(\u0026ImageBase64)\n//ImageBase64 includes linebreaks and java does not support them\n\n\u0026NewLine = CHR(10)\n\u0026ImageBase64NoLines = StrReplace(\u0026ImageBase64, \u0026NewLine, \"\")\n\u0026BlobImage.FromBase64String(\u0026ImageBase64NoLines) \n\n\u0026CaptureImage = \u0026BlobImage\n\n// You can use \u0026CaptureImage to store the signature in the transaction\n// e.g\n// \u0026Client = new()\n// \u0026Client.ClientSignatureImage = \u0026CaptureImage\n// \u0026Client.Save()"
                          },
                          {
                              "blockName":  "Rules",
                              "blockType":  "Rules",
                              "rawSource":  "Parm(in:\u0026ImageBase64);\n",
                              "cleanSource":  "Parm(in:\u0026ImageBase64);"
                          }
