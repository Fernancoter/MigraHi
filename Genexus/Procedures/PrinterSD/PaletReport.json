                              "blockType":  "Rules",
                              "rawSource":  "Parm(in:\u0026PaletId, in:\u0026PDFNombre);\n",
                              "cleanSource":  "Parm(in:\u0026PaletId, in:\u0026PDFNombre);"
                          }
