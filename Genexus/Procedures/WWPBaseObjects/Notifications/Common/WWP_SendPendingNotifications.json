    "name":  "WWP_SendPendingNotifications",
    "type":  "Procedure",
    "module":  "WWPBaseObjects.Notifications.Common",
    "description":  "Send Pending Notifications",
    "filePath":  "Procedures/WWPBaseObjects/Notifications/Common/WWP_SendPendingNotifications.json",
