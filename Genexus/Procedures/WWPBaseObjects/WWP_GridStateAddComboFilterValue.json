                              "blockType":  "Rules",
                              "rawSource":  "\nparm(inout:\u0026GridState, in:\u0026FilterName, in:\u0026FilterDsc, in:\u0026AddFitler, in:\u0026FilterValue, inout:\u0026ComboItems, in:\u0026HasMultipleSelection);\n",
                              "cleanSource":  "\nparm(inout:\u0026GridState, in:\u0026FilterName, in:\u0026FilterDsc, in:\u0026AddFitler, in:\u0026FilterValue, inout:\u0026ComboItems, in:\u0026HasMultipleSelection);"
                          }
