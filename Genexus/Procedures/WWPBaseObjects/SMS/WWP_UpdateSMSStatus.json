                              "blockName":  "Source",
                              "blockType":  "Source",
                              "rawSource":  "\u0026SMS.Load(\u0026SMSId)\n\nIf \u0026SMS.Fail()\n\tWWP_Logger.Error(\u0026Pgmname, !\"SMS not found with id: \" + \u0026SMSId.ToString())\n\treturn\nEndIf\n\n\u0026SMS.WWPSMSProcessed = ServerNow()\n\u0026SMS.WWPSMSStatus = \u0026SMSStatus\n\u0026SMS.WWPSMSDetail = \u0026SMSDetail\n\u0026SMS.Save()\n\nIf \u0026SMS.Fail()\n\tWWP_Logger.Error(\u0026Pgmname, !\"Error updating SMS status with id: \" + \u0026SMSId.ToString())\n\treturn\nEndIf\n",
                              "cleanSource":  "\u0026SMS.Load(\u0026SMSId)\n\nIf \u0026SMS.Fail()\n\tWWP_Logger.Error(\u0026Pgmname, !\"SMS not found with id: \" + \u0026SMSId.ToString())\n\treturn\nEndIf\n\n\u0026SMS.WWPSMSProcessed = ServerNow()\n\u0026SMS.WWPSMSStatus = \u0026SMSStatus\n\u0026SMS.WWPSMSDetail = \u0026SMSDetail\n\u0026SMS.Save()\n\nIf \u0026SMS.Fail()\n\tWWP_Logger.Error(\u0026Pgmname, !\"Error updating SMS status with id: \" + \u0026SMSId.ToString())\n\treturn\nEndIf"
                          },
                          {
