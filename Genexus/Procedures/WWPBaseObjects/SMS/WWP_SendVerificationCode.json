{
    "uniqueId":  "482897e2-2b0a-4f0a-b720-62803f9a546f",
    "name":  "WWP_SendVerificationCode",
    "type":  "Procedure",
    "module":  "WWPBaseObjects.SMS",
    "description":  "Send Verification Code",
    "filePath":  "Procedures/WWPBaseObjects/SMS/WWP_SendVerificationCode.json",
    "isGAMObject":  false,
