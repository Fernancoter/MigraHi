    "businessLogic":  [
                          {
                              "blockName":  "Source",
                              "blockType":  "Source",
                              "rawSource":  "//This is a procedure in which user has to define how to save information related to each end user\n//By default it saves the ColumnsSelector State, the Grid State (filters, orders, etc) and Filters within \u0027ManageFilters\u0027 Action\n\n\u0026UserCustomizationsValue = \u0026Session.Get(\u0026UserCustomizationsKey)\n\nIf (\u0026UserCustomizationsValue.IsEmpty())\n  \u0026UserCustomizations.Load(GAMUser.GetId(),\u0026UserCustomizationsKey)\n  If \u0026UserCustomizations.Success()\n\t  \u0026UserCustomizationsValue = \u0026UserCustomizations.UserCustomizationsValue\n  Else\n\t  \u0026UserCustomizationsValue.SetEmpty()\n  Endif\nEndif\n\n",
                              "cleanSource":  "//This is a procedure in which user has to define how to save information related to each end user\n//By default it saves the ColumnsSelector State, the Grid State (filters, orders, etc) and Filters within \u0027ManageFilters\u0027 Action\n\n\u0026UserCustomizationsValue = \u0026Session.Get(\u0026UserCustomizationsKey)\n\nIf (\u0026UserCustomizationsValue.IsEmpty())\n  \u0026UserCustomizations.Load(GAMUser.GetId(),\u0026UserCustomizationsKey)\n  If \u0026UserCustomizations.Success()\n\t  \u0026UserCustomizationsValue = \u0026UserCustomizations.UserCustomizationsValue\n  Else\n\t  \u0026UserCustomizationsValue.SetEmpty()\n  Endif\nEndif"
                          },
                          {
                              "blockName":  "Rules",
                              "blockType":  "Rules",
                              "rawSource":  "parm(in:\u0026UserCustomizationsKey, out:\u0026UserCustomizationsValue);\n",
                              "cleanSource":  "parm(in:\u0026UserCustomizationsKey, out:\u0026UserCustomizationsValue);"
                          }
                      ],
