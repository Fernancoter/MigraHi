    "businessLogic":  [
                          {
                              "blockName":  "Source",
                              "blockType":  "Source",
                              "rawSource":  "//This is a procedure in which user has to define how to load information related to each end user\n//By default it loads the ColumnsSelector State, the Grid State (filters, orders, etc) and Filters within \u0027ManageFilters\u0027 Action\n\nIf \u0026UserCustomizationsValue.IsEmpty()\n\t\u0026Session.Remove(\u0026UserCustomizationsKey)\nElse\n\t\u0026Session.Set(\u0026UserCustomizationsKey, \u0026UserCustomizationsValue)\nEndIf\n\n\u0026UserCustomizations.Load(GAMUser.GetId(), \u0026UserCustomizationsKey)\nIf \u0026UserCustomizationsValue.IsEmpty()\n\tIf \u0026UserCustomizations.Success()\n\t\t\u0026UserCustomizations.Delete()\n\t\tCommit\n\tEndIf\nElse\n\tIf not \u0026UserCustomizations.Success()\n\t\t\u0026UserCustomizations = new()\n\t\t\u0026UserCustomizations.UserCustomizationsId = GeneXusSecurity.GAMUser.GetId()\n\t\t\u0026UserCustomizations.UserCustomizationsKey = \u0026UserCustomizationsKey\n\tEndIf\n\t\u0026UserCustomizations.UserCustomizationsValue = \u0026UserCustomizationsValue\n\t\u0026UserCustomizations.Save()\n\tCommit\nEndIf\n",
                              "cleanSource":  "//This is a procedure in which user has to define how to load information related to each end user\n//By default it loads the ColumnsSelector State, the Grid State (filters, orders, etc) and Filters within \u0027ManageFilters\u0027 Action\n\nIf \u0026UserCustomizationsValue.IsEmpty()\n\t\u0026Session.Remove(\u0026UserCustomizationsKey)\nElse\n\t\u0026Session.Set(\u0026UserCustomizationsKey, \u0026UserCustomizationsValue)\nEndIf\n\n\u0026UserCustomizations.Load(GAMUser.GetId(), \u0026UserCustomizationsKey)\nIf \u0026UserCustomizationsValue.IsEmpty()\n\tIf \u0026UserCustomizations.Success()\n\t\t\u0026UserCustomizations.Delete()\n\t\tCommit\n\tEndIf\nElse\n\tIf not \u0026UserCustomizations.Success()\n\t\t\u0026UserCustomizations = new()\n\t\t\u0026UserCustomizations.UserCustomizationsId = GeneXusSecurity.GAMUser.GetId()\n\t\t\u0026UserCustomizations.UserCustomizationsKey = \u0026UserCustomizationsKey\n\tEndIf\n\t\u0026UserCustomizations.UserCustomizationsValue = \u0026UserCustomizationsValue\n\t\u0026UserCustomizations.Save()\n\tCommit\nEndIf"
                          },
                          {
                              "blockName":  "Rules",
                              "blockType":  "Rules",
                              "rawSource":  "parm(in:\u0026UserCustomizationsKey,in:\u0026UserCustomizationsValue);\n",
                              "cleanSource":  "parm(in:\u0026UserCustomizationsKey,in:\u0026UserCustomizationsValue);"
                          }
