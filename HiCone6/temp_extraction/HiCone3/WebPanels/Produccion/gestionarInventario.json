      "cleanSource": "\u0026AuditTableName = !\u0027Inventario\u0027\n\t/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */\n\t\u0026LoadSuccess = True\n\tIf (\u0026TrnMode = TrnMode.Display)\n\t\tOR (\u0026TrnMode = TrnMode.Insert AND SecGAMIsAuthByFunctionalityKey.Udp(!\u0027inventario_Insert\u0027))\n\t\tOR (\u0026TrnMode = TrnMode.Update AND SecGAMIsAuthByFunctionalityKey.Udp(!\u0027inventario_Update\u0027))\n\t\tOR (\u0026TrnMode = TrnMode.Delete AND SecGAMIsAuthByFunctionalityKey.Udp(!\u0027inventario_Delete\u0027))\n\t\tIf \u0026TrnMode \u003C\u003E TrnMode.Insert\n\t\t\t\u0026Inventario.Load(\u0026InventarioId)\n\t\t\t\u0026LoadSuccess = \u0026Inventario.Success()\n\t\t\tIf not \u0026LoadSuccess\n\t\t\t\t\u0026Messages = \u0026Inventario.GetMessages()\n\t\t\t\tDo \u0027Show Messages\u0027\n\t\t\tEndIf\n\t\t\tIf \u0026TrnMode = TrnMode.Display OR \u0026TrnMode = TrnMode.Delete\n\t\t\t\tInventario_InventarioFechaHora.Enabled = False\n\t\t\tEndIf\n\t\tEndIf\n\tElse\n\t\t\u0026LoadSuccess = False\n\tEndIf\n\tIf \u0026LoadSuccess\n\t\tIf \u0026TrnMode = TrnMode.Delete\n\t\t\tmsg(\u0027GXM_confdelete\u0027)\n\t\tEndIf\n\tEndIf\n\tDo \u0027AttributesSecurityCode\u0027\n\twcAuditoria.Object = AuditHistoryById.Create(\u0026AuditTableName, \u0026InventarioId)\n\t/* Generated by DVelop Work With Plus Pattern [End] - Do not change */"
