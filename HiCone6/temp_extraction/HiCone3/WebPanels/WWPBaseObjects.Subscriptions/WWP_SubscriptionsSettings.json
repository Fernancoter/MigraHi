  "description": "Manage my Subscriptions",
  "isGAMObject": false,
  "interfaceElements": [],
  "businessLogic": [
    {
      "blockName": "Start",
      "blockType": "Event",
      "rawSource": "(Extracted from full RTF)",
      "cleanSource": "/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */\n\tCell_Grid_DWC.Class = !\u0027Invisible WCD_\u0027 \u002B upper(Grid.InternalName)\n\t\n\tGrid.Rows = 50\n\tGrid_Empowerer.GridInternalName = Grid.InternalName\n\tForm.Caption = \u0027Manage my Subscriptions\u0027\n\tDo \u0027LoadGridState\u0027\n\tGridPaginationBar.RowsPerPageSelectedValue = Grid.Rows\n\t/* Generated by DVelop Work With Plus Pattern [End] - Do not change */\n\tFor Each WWPBaseObjects.WWP_UserExtended\n\t\tWhere WWPUserExtendedId = WWP_GetLoggedUserId()\n\t\t\u0026Sms = WWPUserExtendedSMSNotif\n\t\t\u0026Mail = WWPUserExtendedEmaiNotif\n\t\t\u0026Desktop = WWPUserExtendedDesktopNotif\n\t\t\u0026SD = WWPUserExtendedMobileNotif\n\tEndFor"
    },
    {
      "blockName": "Refresh",
      "blockType": "Event",
      "rawSource": "(Extracted from full RTF)",
      "cleanSource": "/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */\n\tLoadWWPContext.Call(\u0026WWPContext)\n\tDo \u0027SaveGridState\u0027\n\t\u0026GridCurrentPage = Grid.CurrentPage\n\t//\u0026GridPageCount has to be loaded manually\n\t\u0026GridAppliedFilters = WWP_GetAppliedFiltersDescription(\u0026Pgmname)\n\t/* Generated by DVelop Work With Plus Pattern [End] - Do not change */"
    },
    {
      "blockName": "GridPaginationBar.ChangePage",
      "blockType": "Event",
      "rawSource": "(Extracted from full RTF)",
      "cleanSource": "/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */\n\tDo Case\n\t\tCase GridPaginationBar.SelectedPage = !\u0027Previous\u0027\n\t\t\tGrid.PreviousPage()\n\t\tCase GridPaginationBar.SelectedPage = !\u0027Next\u0027\n\t\t\tGrid.NextPage()\n\t\tOtherwise\n\t\t\t\u0026PageToGo.FromString(GridPaginationBar.SelectedPage)\n\t\t\tGrid.GotoPage(\u0026PageToGo)\n\tEndCase\n\t/* Generated by DVelop Work With Plus Pattern [End] - Do not change */"
    },
    {
      "blockName": "GridPaginationBar.ChangeRowsPerPage",
      "blockType": "Event",
      "rawSource": "(Extracted from full RTF)",
      "cleanSource": "/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */\n\tGrid.Rows = GridPaginationBar.RowsPerPageSelectedValue\n\tGrid.FirstPage()\n\t/* Generated by DVelop Work With Plus Pattern [End] - Do not change */"
    },
    {
      "blockName": "Grid.Load",
      "blockType": "Event",
      "rawSource": "(Extracted from full RTF)",
      "cleanSource": "\u0026GridRecordCount = 0\n\t\u0026WWPSubscriptionRoleIdCollection = WWP_GetLoggedUserRoles()\n\tFor Each WWP_Entity\n\t/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */\n\t//this code should be inside the For Each used to load the data\n\t\n\t//Sample conditions to be added manually:\n\t//Where \u003CAttribute\u003E = \u0026NotifShowOnlySubscribedEvents when not \u0026NotifShowOnlySubscribedEvents.IsEmpty()\n\t\n\t\u0026DetailWebComponent = !\u0027\u003Ci class=\u0022fas fa-angle-right ArrowIcon\u0022\u003E\u003C/i\u003E\u0027\n\t/* Generated by DVelop Work With Plus Pattern [End] - Do not change */\n\t\t\u0026WWPEntityName = WWPEntityName\n\t\t\u0026WWPEntityId = WWPEntityId\n\t\t\u0026EntityHasItemsToShow = False\n\t\tIf (Not \u0026NotifShowOnlySubscribedEvents) AND WWP_HasSubscriptionsToDisplay(\u0026WWPEntityName, WWP_NotificationAppliesTo.AnyRecord)\n\t\t\t\u0026EntityHasItemsToShow = True\n\t\tElse\n\t\t\tFor Each WWP_Subscription\n\t\t\tWhere WWPNotificationDefinitionAllowUserSubscription\n\t\t\tWhere (WWPUserExtendedId = WWP_GetLoggedUserId() And WWPSubscriptionSubscribed = True) Or WWPSubscriptionRoleId In \u0026WWPSubscriptionRoleIdCollection\n\t\t\t\t\u0026EntityHasItemsToShow = True\n\t\t\t\tIf Not WWPSubscriptionRoleId.IsEmpty()\n\t\t\t\t\tWWP_CheckUserIsNotUnsubscribed(WWPNotificationDefinitionId, 0, \u0026EntityHasItemsToShow)\n\t\t\t\tEndIf\n\t\n\t\t\t\tIf \u0026EntityHasItemsToShow\n\t\t\t\t\tExit\n\t\t\t\tEndIf\n\t\t\tEndFor\n\t\tEndIf\n\t\tIf \u0026EntityHasItemsToShow\n\t\t\t\u0026GridRecordCount \u002B= 1\n\t\t\tLoad\n\t\tEndIf\n\t\t\n\tEndFor\n\t\u0026GridPageCount = \u0026GridRecordCount/Grid.Rows \u002B iif(Mod(\u0026GridRecordCount, Grid.Rows) \u003E 0, 1, 0)"
    },
    {
      "blockName": "\u0026DetailWebComponent.Click",
      "blockType": "Event",
      "rawSource": "(Extracted from full RTF)",
      "cleanSource": "/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */\n\tGrid_DWC.Object = WWP_SubscriptionsSettingsWC.Create(\u0026WWPEntityId, \u0026NotifShowOnlySubscribedEvents)\n\t/* Generated by DVelop Work With Plus Pattern [End] - Do not change */"
    },
    {
      "blockName": "\u0026Mail.Click",
      "blockType": "Event",
      "rawSource": "(Extracted from full RTF)",
      "cleanSource": "\u0026WWPUserExtended.Load(WWP_GetLoggedUserId())\n\t\u0026WWPUserExtended.WWPUserExtendedEmaiNotif = \u0026Mail\n\t\u0026WWPUserExtended.Save()\n\tIf \u0026WWPUserExtended.Success()\n\t\tCommit\n\tEndIf"
    },
