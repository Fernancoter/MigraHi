  "businessLogic": [
    {
      "blockName": "Start",
      "blockType": "Event",
      "rawSource": "(Extracted from full RTF)",
      "cleanSource": "/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */\n\tGrid.Rows = Page.Rows\n\tGrid_Empowerer.GridInternalName = Grid.InternalName\n\tIf \u0026HTTPRequest.Method = HttpMethod.Get\n\t\tDo \u0027LoadSavedFilters\u0027\n\tEndIf\n\t\u0026IsAuthorized_Name = SecGAMIsAuthByFunctionalityKey.Udp(!\u0027gamroleentry_Execute\u0027)\n\t\n\tForm.Caption = \u0027WWP_GAM_Roles\u0027\n\tDo \u0027LoadGridState\u0027\n\tGridPaginationBar.RowsPerPageSelectedValue = Grid.Rows\n\t/* Generated by DVelop Work With Plus Pattern [End] - Do not change */\n\t\u0026BtnRole.Title = \u0022WWP_GAM_Children\u0022\n\t\u0026BtnPrm.Title = \u0022WWP_GAM_Permissions\u0022\n\t\u0026BtnSaveAs.Title = \u0022WWP_GAM_Copy\u0022\n\t\u0026BtnSubscriptions.Title = \u0022WWP_GAM_Subscriptions\u0022"
    },
    {
      "blockName": "Refresh",
      "blockType": "Event",
      "rawSource": "(Extracted from full RTF)",
      "cleanSource": "/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */\n\tLoadWWPContext.Call(\u0026WWPContext)\n\tDo \u0027CheckSecurityForActions\u0027\n\tDo Case\n\t\tCase \u0026ManageFiltersExecutionStep = 1\n\t\t\t\u0026ManageFiltersExecutionStep = 2\n\t\tCase \u0026ManageFiltersExecutionStep = 2\n\t\t\t\u0026ManageFiltersExecutionStep = 0\n\t\t\tDo \u0027LoadSavedFilters\u0027\n\tEndCase\n\tDo \u0027SaveGridState\u0027\n\t\u0026GridCurrentPage = Grid.CurrentPage\n\t//\u0026GridPageCount has to be loaded manually\n\t\u0026GridAppliedFilters = WWP_GetAppliedFiltersDescription(\u0026Pgmname)\n\t/* Generated by DVelop Work With Plus Pattern [End] - Do not change */"
    },
    {
      "blockName": "GridPaginationBar.ChangePage",
      "blockType": "Event",
      "rawSource": "(Extracted from full RTF)",
      "cleanSource": "/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */\n\tDo Case\n\t\tCase GridPaginationBar.SelectedPage = !\u0027Previous\u0027\n\t\t\tGrid.PreviousPage()\n\t\tCase GridPaginationBar.SelectedPage = !\u0027Next\u0027\n\t\t\tGrid.NextPage()\n\t\tOtherwise\n\t\t\t\u0026PageToGo.FromString(GridPaginationBar.SelectedPage)\n\t\t\tGrid.GotoPage(\u0026PageToGo)\n\tEndCase\n\t/* Generated by DVelop Work With Plus Pattern [End] - Do not change */"
    },
    {
      "blockName": "GridPaginationBar.ChangeRowsPerPage",
      "blockType": "Event",
      "rawSource": "(Extracted from full RTF)",
      "cleanSource": "/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */\n\tGrid.Rows = GridPaginationBar.RowsPerPageSelectedValue\n\tGrid.FirstPage()\n\t/* Generated by DVelop Work With Plus Pattern [End] - Do not change */"
    },
    {
      "blockName": "Grid.Load",
      "blockType": "Event",
      "rawSource": "(Extracted from full RTF)",
      "cleanSource": "\u0026GridPageSize = Grid.Rows\n\t\u0026Filter.Name =  !\u0022%\u0022 \u002B \u0026FilName\n\t\u0026Filter.ExternalId = !\u0022%\u0022 \u002B \u0026FilExternalId\n\t\u0026GAMRoles = GAMRepository.GetRoles(\u0026Filter, \u0026Errors)\n\tIf \u0026GAMRoles.Count = 0\n\t\t\u0026GridPageCount = 0\n\tElse\n\t\t\u0026GridPageCount = (\u0026GAMRoles.Count / \u0026GridPageSize) \u002B iif(Mod(\u0026GAMRoles.Count, \u0026GridPageSize) \u003E 0, 1, 0)\n\tEndIf\n\t\u0026GridRecordCount = \u0026GAMRoles.Count\n\tFor \u0026Role in \u0026GAMRoles\n\t\t\u0026Id\t  = \u0026Role.Id\n\t\t\u0026Name = \u0026Role.Name\n\t/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */\n\t//this code should be inside the For Each used to load the data\n\t\n\t//Sample conditions to be added manually:\n\t//Where \u003CAttribute\u003E like \u0026FilName when not \u0026FilName.IsEmpty()\n\t\n\t\u0026Update = !\u0027\u003Ci class=\u0022fa fa-pen\u0022\u003E\u003C/i\u003E\u0027\n\t\n\t\u0026Delete = !\u0027\u003Ci class=\u0022fa fa-times\u0022\u003E\u003C/i\u003E\u0027\n\t\n\t\u0026BtnRole = !\u0027\u003Ci class=\u0022fa fa-cog\u0022\u003E\u003C/i\u003E\u0027\n\tIf (\u0026IsAuthorized_BtnRole)\n\t\t\u0026BtnRole.Link = GAMWWRoleRoles.Link(\u0026Id, \u0026Id)\n\tEndif\n\t\u0026BtnPrm = !\u0027\u003Ci class=\u0022fa fa-lock\u0022\u003E\u003C/i\u003E\u0027\n\tIf (\u0026IsAuthorized_BtnPrm)\n\t\t\u0026BtnPrm.Link = GAMWWRolePermissions.Link(\u0026Id, 0)\n\tEndif\n\t\u0026BtnSaveAs = !\u0027\u003Ci class=\u0022fas fa-copy\u0022\u003E\u003C/i\u003E\u0027\n\t\n\t\u0026BtnSubscriptions = !\u0027\u003Ci class=\u0022fas fa-rss\u0022\u003E\u003C/i\u003E\u0027\n\tIf (\u0026IsAuthorized_BtnSubscriptions)\n\t\t\u0026BtnSubscriptions.Link = WWP_SubscriptionsSettingsByRole.Link(\u0026Role.GUID)\n\tEndif\n\tIf (\u0026IsAuthorized_Name)\n\t\t\u0026Name.Link = GAMRoleEntry.Link(GAMAPiMode.Display, \u0026Id)\n\tEndif\n\t/* Generated by DVelop Work With Plus Pattern [End] - Do not change */\n\t\tGrid.Load()\n\tEndFor"
    },
    {
      "blockName": "ddo_ManageFilters.OnOptionClicked",
      "blockType": "Event",
      "rawSource": "(Extracted from full RTF)",
      "cleanSource": "/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */\n\tDo Case\n\t\tCase ddo_ManageFilters.ActiveEventKey = !\u0027\u003C#Clean#\u003E\u0027\n\t\t\tDo \u0027CleanFilters\u0027\n\t\t\tGrid.FirstPage()\n\t\t\tRefresh\n\t\tCase ddo_ManageFilters.ActiveEventKey = !\u0027\u003C#Save#\u003E\u0027\n\t\t\tDo \u0027SaveGridState\u0027\n\t\t\tSaveFilterAs.Popup(!\u0027GAMWWRolesFilters\u0027, \u0026PgmName \u002B !\u0022GridState\u0022)\n\t\t\t\u0026ManageFiltersExecutionStep = 2\n\t\t\tRefresh\n\t\tCase ddo_ManageFilters.ActiveEventKey = !\u0027\u003C#Manage#\u003E\u0027\n\t\t\tManageFilters.Popup(!\u0027GAMWWRolesFilters\u0027)\n\t\t\t\u0026ManageFiltersExecutionStep = 2\n\t\t\tRefresh\n\t\tOtherwise\n\t\t\t\u0026ManageFiltersXml = GetFilterByName(!\u0027GAMWWRolesFilters\u0027, ddo_ManageFilters.ActiveEventKey)\n\t\t\tIf \u0026ManageFiltersXml.IsEmpty()\n\t\t\t\tmsg(\u0027WWP_FilterNotExist\u0027)\n\t\t\tElse\n\t\t\t\tDo \u0027CleanFilters\u0027\n\t\t\t\tSaveGridState.Call(\u0026PgmName \u002B !\u0022GridState\u0022,  \u0026ManageFiltersXml)\n\t\t\t\t\u0026GridState.FromXml(\u0026ManageFiltersXml)\n\t\t\t\tDo \u0027LoadRegFiltersState\u0027\n\t\t\t\tGrid.FirstPage()\n\t\t\t\tRefresh\n\t\t\tEndIf\n\tEndCase\n\t/* Generated by DVelop Work With Plus Pattern [End] - Do not change */"
    },
    {
      "blockName": "\u0027DoInsert\u0027",
      "blockType": "Event",
      "rawSource": "(Extracted from full RTF)",
      "cleanSource": "/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */\n\tIf (\u0026IsAuthorized_Insert)\n\t\tGAMRoleEntry.Call(GAMAPiMode.Insert, 0)\n\tElse\n\t\tmsg(\u0022WWP_ActionNoLongerAvailable\u0022)\n\t\tRefresh\n\tEndif\n\t/* Generated by DVelop Work With Plus Pattern [End] - Do not change */"
    },
    {
      "blockName": "\u0026BtnSaveAs.Click",
      "blockType": "Event",
      "rawSource": "(Extracted from full RTF)",
      "cleanSource": "\u0026Role.Load(\u0026Id)\n\t\u0026isOK = \u0026Role.SaveAs(\u0026NewGAMRole, \u0026Errors)\n\tIf \u0026isOK\n\t\tcommit\n\t\tRefresh\n\tElse\n\t\tFor \u0026Error in \u0026Errors\n\t\t\tMsg(Format(!\u0022%1 (GAM%2)\u0022, \u0026Error.Message, \u0026Error.Code))\n\t\tEndFor\n\tEndif"
    },
