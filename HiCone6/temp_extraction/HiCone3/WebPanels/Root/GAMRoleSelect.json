    {
      "blockName": "Grid.Load",
      "blockType": "Event",
      "rawSource": "(Extracted from full RTF)",
      "cleanSource": "\u0026GAMRole.Load(\u0026RoleIdAux)\n\t\u0026Filter.Name\t\t= !\u0022%\u0022 \u002B \u0026FilName\n\t\u0026Filter.ExternalId\t= \u0026FilExternalId\n\t\u0026GamRoles = \u0026GAMRole.GetUnassignedRoles(\u0026Filter, \u0026Errors)\n\tif \u0026GamRoles.count=0\n\t\t\u0026GridPageCount=0\n\telse\n\t\t\u0026GridPageCount=(\u0026GamRoles.count/Page.Rows)\u002B1\n\tendif\n\t\u0026GridRecordCount = \u0026GamRoles.Count\n\tFor \u0026Role in \u0026GamRoles\n\t\t\u0026Select\t= False\n\t\t\u0026Id\t  = \u0026Role.Id\n\t\t\u0026Name = \u0026Role.Name\n\t\tGrid.Load()\n\tEndFor\n\t/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */\n\t//this code should be inside the For Each used to load the data\n\t\n\t//Sample conditions to be added manually:\n\t//Where \u003CAttribute\u003E like \u0026FilName when not \u0026FilName.IsEmpty()\n\t//Where \u003CAttribute\u003E like \u0026FilExternalId when not \u0026FilExternalId.IsEmpty()\n\t\n\t\u0026Update = !\u0027\u003Ci class=\u0022fa fa-pen\u0022\u003E\u003C/i\u003E\u0027\n\t\n\t\u0026Delete = !\u0027\u003Ci class=\u0022fa fa-times\u0022\u003E\u003C/i\u003E\u0027\n\t/* Generated by DVelop Work With Plus Pattern [End] - Do not change */"
    },
    {
      "blockName": "ddo_ManageFilters.OnOptionClicked",
      "blockType": "Event",
      "rawSource": "(Extracted from full RTF)",
      "cleanSource": "/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */\n\tDo Case\n\t\tCase ddo_ManageFilters.ActiveEventKey = !\u0027\u003C#Clean#\u003E\u0027\n\t\t\tDo \u0027CleanFilters\u0027\n\t\t\tGrid.FirstPage()\n\t\t\tRefresh\n\t\tCase ddo_ManageFilters.ActiveEventKey = !\u0027\u003C#Save#\u003E\u0027\n\t\t\tDo \u0027SaveGridState\u0027\n\t\t\tSaveFilterAs.Popup(!\u0027GAMRoleSelectFilters\u0027, \u0026PgmName \u002B !\u0022GridState\u0022)\n\t\t\t\u0026ManageFiltersExecutionStep = 2\n\t\t\tRefresh\n\t\tCase ddo_ManageFilters.ActiveEventKey = !\u0027\u003C#Manage#\u003E\u0027\n\t\t\tManageFilters.Popup(!\u0027GAMRoleSelectFilters\u0027)\n\t\t\t\u0026ManageFiltersExecutionStep = 2\n\t\t\tRefresh\n\t\tOtherwise\n\t\t\t\u0026ManageFiltersXml = GetFilterByName(!\u0027GAMRoleSelectFilters\u0027, ddo_ManageFilters.ActiveEventKey)\n\t\t\tIf \u0026ManageFiltersXml.IsEmpty()\n\t\t\t\tmsg(\u0027WWP_FilterNotExist\u0027)\n\t\t\tElse\n\t\t\t\tDo \u0027CleanFilters\u0027\n\t\t\t\tSaveGridState.Call(\u0026PgmName \u002B !\u0022GridState\u0022,  \u0026ManageFiltersXml)\n\t\t\t\t\u0026GridState.FromXml(\u0026ManageFiltersXml)\n\t\t\t\tDo \u0027LoadRegFiltersState\u0027\n\t\t\t\tGrid.FirstPage()\n\t\t\t\tRefresh\n\t\t\tEndIf\n\tEndCase\n\t/* Generated by DVelop Work With Plus Pattern [End] - Do not change */"
    },
    {
      "blockName": "\u0027DoAdd\u0027",
      "blockType": "Event",
      "rawSource": "(Extracted from full RTF)",
      "cleanSource": "\u0026GAMRole.Load(\u0026RoleIdAux)\n\t\n\tFor each line\n\t\tIf \u0026Select\n\t\t\t\u0026isOK = \u0026GAMRole.AddRoleById(\u0026Id, \u0026Errors)\n\t\t\tIf not \u0026isOK\n\t\t\t\tFor \u0026Error in \u0026Errors\n\t\t\t\t\tMsg(Format(!\u0022%1 (GAM%2)\u0022, \u0026Error.Message, \u0026Error.Code))\n\t\t\t\tEndFor\t\n\t\t\t\tExit\n\t\t\tEndif\t\t\n\t\tEndif\n\tEndFor\n\tIf \u0026isOK\n\t\tCommit\n\t\treturn\n\tElse\n\t\tFor \u0026Error in \u0026Errors\n\t\t\tMsg(Format(!\u0022%1 (GAM%2)\u0022, \u0026Error.Message, \u0026Error.Code))\n\t\tEndFor\t\t\n\tEndif\n\t/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */\n\t/* Generated by DVelop Work With Plus Pattern [End] - Do not change */"
