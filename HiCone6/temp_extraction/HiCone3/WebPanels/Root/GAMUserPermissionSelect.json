      "blockName": "Start",
      "blockType": "Event",
      "rawSource": "(Extracted from full RTF)",
      "cleanSource": "If \u0026UserId.IsEmpty() or \u0026ApplicationId.IsEmpty()\n\t\treturn\n\tEndif\n\t\n\tForm.Caption = Format(\u0022WWP_GAM_AddPermissionsToUser\u0022, \u0026GAMRole.Name.Trim(), \u0026GAMApplication.Name.Trim())\n\t/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */\n\tGrid.Rows = Page.Rows\n\tGrid_Empowerer.GridInternalName = Grid.InternalName\n\tIf \u0026HTTPRequest.Method = HttpMethod.Get\n\t\tDo \u0027LoadSavedFilters\u0027\n\tEndIf\n\t\u0026IsAuthorized_Name = SecGAMIsAuthByFunctionalityKey.Udp(!\u0027gamapppermissionentry_Execute\u0027)\n\t\n\tForm.Caption = \u0027WWP_GAM_SelectPermissionsUser\u0027\n\tDo \u0027LoadGridState\u0027\n\tGridPaginationBar.RowsPerPageSelectedValue = Grid.Rows\n\t/* Generated by DVelop Work With Plus Pattern [End] - Do not change */"
    },
    {
      "blockName": "Refresh",
      "blockType": "Event",
      "rawSource": "(Extracted from full RTF)",
      "cleanSource": "/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */\n\tLoadWWPContext.Call(\u0026WWPContext)\n\tDo Case\n\t\tCase \u0026ManageFiltersExecutionStep = 1\n\t\t\t\u0026ManageFiltersExecutionStep = 2\n\t\tCase \u0026ManageFiltersExecutionStep = 2\n\t\t\t\u0026ManageFiltersExecutionStep = 0\n\t\t\tDo \u0027LoadSavedFilters\u0027\n\tEndCase\n\tDo \u0027SaveGridState\u0027\n\t\u0026GridCurrentPage = Grid.CurrentPage\n\t//\u0026GridPageCount has to be loaded manually\n\t\u0026GridAppliedFilters = WWP_GetAppliedFiltersDescription(\u0026Pgmname)\n\t/* Generated by DVelop Work With Plus Pattern [End] - Do not change */"
    },
    {
      "blockName": "GridPaginationBar.ChangePage",
      "blockType": "Event",
      "rawSource": "(Extracted from full RTF)",
      "cleanSource": "/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */\n\tDo Case\n\t\tCase GridPaginationBar.SelectedPage = !\u0027Previous\u0027\n\t\t\tGrid.PreviousPage()\n\t\tCase GridPaginationBar.SelectedPage = !\u0027Next\u0027\n\t\t\tGrid.NextPage()\n\t\tOtherwise\n\t\t\t\u0026PageToGo.FromString(GridPaginationBar.SelectedPage)\n\t\t\tGrid.GotoPage(\u0026PageToGo)\n\tEndCase\n\t/* Generated by DVelop Work With Plus Pattern [End] - Do not change */"
    },
    {
      "blockName": "GridPaginationBar.ChangeRowsPerPage",
      "blockType": "Event",
      "rawSource": "(Extracted from full RTF)",
      "cleanSource": "/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */\n\tGrid.Rows = GridPaginationBar.RowsPerPageSelectedValue\n\tGrid.FirstPage()\n\t/* Generated by DVelop Work With Plus Pattern [End] - Do not change */"
    },
    {
      "blockName": "Grid.Load",
      "blockType": "Event",
      "rawSource": "(Extracted from full RTF)",
      "cleanSource": "\u0026GAMUser.Load(\u0026UserId)\n\t\u0026GAMUserName = \u0026GAMUser.Name\n\t\u0026GAMApplication.Load(\u0026ApplicationId)\n\t\u0026PermissionFilter.ApplicationId = \u0026ApplicationId\n\t\u0026PermissionFilter.Name\t= !\u0022%\u0022 \u002B \u0026Search\n\t\u0026PermissionFilter.AccessType.FromString(\u0026PermissionAccessType)\n\t\u0026PermissionFilter.Inherited.FromString(\u0026BoolenFilter)\n\tIf not \u0026ApplicationId.IsEmpty()\n\t\t\u0026GAMPermissions = \u0026GAMUser.GetUnassignedPermissions(\u0026PermissionFilter, \u0026Errors)\n\t\tif \u0026GamPermissions.count=0\n\t\t\t\u0026GridPageCount=0\n\t\telse\n\t\t\t\u0026GridPageCount=(\u0026GamPermissions.count/Page.Rows)\u002B1\n\t\tendif\n\t\t\u0026GridRecordCount = \u0026GamPermissions.Count\n\t\tFor \u0026Permission in \u0026GAMPermissions\n\t\t\t\u0026CountPermissions\u002B= 1\n\t\t\t\u0026Id\t\t= \u0026Permission.GUID\n\t\t\t\u0026Name \t= \u0026Permission.Name\n\t\t\t\u0026Dsc \t= \u0026Permission.Description\n\t/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */\n\t//this code should be inside the For Each used to load the data\n\t\n\t//Sample conditions to be added manually:\n\t//Where \u003CAttribute\u003E like \u0026Search when not \u0026Search.IsEmpty()\n\t//Where \u003CAttribute\u003E = \u0026PermissionAccessType when not \u0026PermissionAccessType.IsEmpty()\n\t//Where \u003CAttribute\u003E = \u0026BoolenFilter when not \u0026BoolenFilter.IsEmpty()\n\t\n\tIf (\u0026IsAuthorized_Name)\n\t\t//\u0026Name.Link = GAMAppPermissionEntry.Link(GAMAPiMode.Display, \u0026ApplicationId, \u0026ID)\n\tEndif\n\t/* Generated by DVelop Work With Plus Pattern [End] - Do not change */\n\t\tGrid.Load()\n\tEndFor\n\tEndif"
    },
    {
      "blockName": "ddo_ManageFilters.OnOptionClicked",
      "blockType": "Event",
      "rawSource": "(Extracted from full RTF)",
      "cleanSource": "/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */\n\tDo Case\n\t\tCase ddo_ManageFilters.ActiveEventKey = !\u0027\u003C#Clean#\u003E\u0027\n\t\t\tDo \u0027CleanFilters\u0027\n\t\t\tGrid.FirstPage()\n\t\t\tRefresh\n\t\tCase ddo_ManageFilters.ActiveEventKey = !\u0027\u003C#Save#\u003E\u0027\n\t\t\tDo \u0027SaveGridState\u0027\n\t\t\tSaveFilterAs.Popup(!\u0027GAMUserPermissionSelectFilters\u0027, \u0026PgmName \u002B !\u0022GridState\u0022)\n\t\t\t\u0026ManageFiltersExecutionStep = 2\n\t\t\tRefresh\n\t\tCase ddo_ManageFilters.ActiveEventKey = !\u0027\u003C#Manage#\u003E\u0027\n\t\t\tManageFilters.Popup(!\u0027GAMUserPermissionSelectFilters\u0027)\n\t\t\t\u0026ManageFiltersExecutionStep = 2\n\t\t\tRefresh\n\t\tOtherwise\n\t\t\t\u0026ManageFiltersXml = GetFilterByName(!\u0027GAMUserPermissionSelectFilters\u0027, ddo_ManageFilters.ActiveEventKey)\n\t\t\tIf \u0026ManageFiltersXml.IsEmpty()\n\t\t\t\tmsg(\u0027WWP_FilterNotExist\u0027)\n\t\t\tElse\n\t\t\t\tDo \u0027CleanFilters\u0027\n\t\t\t\tSaveGridState.Call(\u0026PgmName \u002B !\u0022GridState\u0022,  \u0026ManageFiltersXml)\n\t\t\t\t\u0026GridState.FromXml(\u0026ManageFiltersXml)\n\t\t\t\tDo \u0027LoadRegFiltersState\u0027\n\t\t\t\tGrid.FirstPage()\n\t\t\t\tRefresh\n\t\t\tEndIf\n\tEndCase\n\t/* Generated by DVelop Work With Plus Pattern [End] - Do not change */"
    },
    {
      "blockName": "\u0027DoAdd\u0027",
      "blockType": "Event",
      "rawSource": "(Extracted from full RTF)",
      "cleanSource": "\u0026GAMUser.Load(\u0026UserId)\n\tFor each line\n\t\tIf \u0026Select\n\t\t\t\u0026PermissionAdd.ApplicationId= \u0026ApplicationId\n\t\t\t\u0026PermissionAdd.GUID\t\t  \t= \u0026Id\n\t\t\t\u0026PermissionAdd.Type.FromString(\u0026Access)\n\t\t\t\u0026isOK = \u0026GAMUser.AddPermission(\u0026PermissionAdd, \u0026Errors)\n\t\t\tIf not \u0026isOK\n\t\t\t\tFor \u0026Error in \u0026Errors\n\t\t\t\t\tMsg(Format(!\u0022%1 (GAM%2)\u0022, \u0026Error.Message, \u0026Error.Code))\n\t\t\t\tEndFor\t\n\t\t\t\tExit\n\t\t\tEndif\t\t\n\t\tEndif\n\tEndFor\n\tIf \u0026isOK\n\t\tCommit\n\t\tGAMWWUserPermissions(\u0026UserId, \u0026ApplicationId)\n\tElse\n\t\tFor \u0026Error in \u0026Errors\n\t\t\tMsg(Format(!\u0022%1 (GAM%2)\u0022, \u0026Error.Message, \u0026Error.Code))\n\t\tEndFor\t\t\n\tEndif\n\t/* Generated by DVelop Work With Plus Pattern [Start] - Do not change */\n\t/* Generated by DVelop Work With Plus Pattern [End] - Do not change */"
