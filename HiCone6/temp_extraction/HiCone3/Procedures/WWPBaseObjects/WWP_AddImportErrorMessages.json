  "name": "WWP_AddImportErrorMessages",
  "type": "Procedure",
  "module": "WWPBaseObjects",
  "description": "WWP_Add Import Error Messages",
  "isGAMObject": false,
  "interfaceElements": [],
  "businessLogic": [
    {
      "blockName": "Source",
      "blockType": "Source",
      "rawSource": "\nIf not \u0026LineId.IsEmpty()\n\tWWP_AddMessage(!\u0027WWP_LineId\u0027, MessageTypes.Info, format(\u0027File line: %1\u0027, \u0026LineId), \u0026Messages)\nEndIf\n\nFor \u0026Message in \u0026ErrorsToAdd\n\tIf \u0026Message.Type = MessageTypes.Error\n\t\t\u0026Messages.Add(\u0026Message)\n\tEndIf\nEndFor\n",
      "cleanSource": "\nIf not \u0026LineId.IsEmpty()\n\tWWP_AddMessage(!\u0027WWP_LineId\u0027, MessageTypes.Info, format(\u0027File line: %1\u0027, \u0026LineId), \u0026Messages)\nEndIf\n\nFor \u0026Message in \u0026ErrorsToAdd\n\tIf \u0026Message.Type = MessageTypes.Error\n\t\t\u0026Messages.Add(\u0026Message)\n\tEndIf\nEndFor"
    },
    {
      "blockName": "Rules",
      "blockType": "Rules",
      "rawSource": "\nparm(inout:\u0026Messages, in:\u0026LineId, in:\u0026ErrorsToAdd);\n",
      "cleanSource": "\nparm(inout:\u0026Messages, in:\u0026LineId, in:\u0026ErrorsToAdd);"
    }
  ],
