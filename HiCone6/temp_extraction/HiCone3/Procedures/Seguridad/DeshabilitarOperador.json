  "businessLogic": [
    {
      "blockName": "Source",
      "blockType": "Source",
      "rawSource": "\u0026isOk = False\n\n\u0026User.Load(\u0026Operador.OperadorUserGUID)\n\t\t\t\nIf \u0026User.IsEnabledInRepository\n\t\u0026isOK = \u0026User.RepositoryDisable(\u0026Errors) \nEndIf\n\nIf \u0026isOK\n    \n\t\u0026Operador.OperadorActivo = False\n\t\u0026Operador.Save()\n\t\u0026isOk = \u0026Operador.Success()\n\t\n\tIf Not \u0026isOk\n\t\tWeb.SetNotSuccessMessagesLog.Call(\u0026Operador.GetMessages(), \u0026Pgmname)\n\tEndIf\n\t\nElse\n\t\n\tFor \u0026Error in \u0026Errors\n        Msg(Format(!\u0022%1 (GAM%2)\u0022, \u0026Error.Message, \u0026Error.Code))\n    EndFor\n\t\nEndIf\n\t\t\n\t\t\n",
      "cleanSource": "\u0026isOk = False\n\n\u0026User.Load(\u0026Operador.OperadorUserGUID)\n\t\t\t\nIf \u0026User.IsEnabledInRepository\n\t\u0026isOK = \u0026User.RepositoryDisable(\u0026Errors) \nEndIf\n\nIf \u0026isOK\n    \n\t\u0026Operador.OperadorActivo = False\n\t\u0026Operador.Save()\n\t\u0026isOk = \u0026Operador.Success()\n\t\n\tIf Not \u0026isOk\n\t\tWeb.SetNotSuccessMessagesLog.Call(\u0026Operador.GetMessages(), \u0026Pgmname)\n\tEndIf\n\t\nElse\n\t\n\tFor \u0026Error in \u0026Errors\n        Msg(Format(!\u0022%1 (GAM%2)\u0022, \u0026Error.Message, \u0026Error.Code))\n    EndFor\n\t\nEndIf"
    },
