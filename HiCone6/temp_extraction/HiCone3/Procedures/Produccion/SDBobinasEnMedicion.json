      "blockName": "Source",
      "blockType": "Source",
      "rawSource": "\t\u0026isOK = true\n\t\n\t//Cambiar estado de las bobinas En Proceso -: En Medici\u00F3n\n\tFor each DB.Bobina\n\t\twhere BobinaId \u003E 0\n\t\twhere ExtrusionId = \u0026ExtrusionId\n\t\t\u0026BobinaEstado = BobinaEstado\n\t        \n\t\tif(\u0026BobinaEstado = EstadoBobina.EnMedicion)\n\t\t      \u0026isOK = false\n\t\t      Exit\n\t        endif\n\tEndfor\n",
      "cleanSource": "\t\u0026isOK = true\n\t\n\t//Cambiar estado de las bobinas En Proceso -: En Medici\u00F3n\n\tFor each DB.Bobina\n\t\twhere BobinaId \u003E 0\n\t\twhere ExtrusionId = \u0026ExtrusionId\n\t\t\u0026BobinaEstado = BobinaEstado\n\t        \n\t\tif(\u0026BobinaEstado = EstadoBobina.EnMedicion)\n\t\t      \u0026isOK = false\n\t\t      Exit\n\t        endif\n\tEndfor"
    },
