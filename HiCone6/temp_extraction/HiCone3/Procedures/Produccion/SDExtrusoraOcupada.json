  "businessLogic": [
    {
      "blockName": "Source",
      "blockType": "Source",
      "rawSource": " \n \u0026ExtActivaId = 0\n \u0026Disponible = false\n \n for each DB.Extrusion\n\t where ExtrusionId \u003E 0\n\t where ExtrusionId \u003C\u003E \u0026ExtrusionId\n\t where ExtrusionExtrusoraId = \u0026ExtrusoraId\n\t \u0026ExtrusionEstado = ExtrusionEstado\n\t \n\t Do Case\n\t\t Case \u0026ExtrusionEstado = EstadoExtrusion.EnProceso\n\t\t      \u0026ExtActivaId = ExtrusionId\n\t\t      Exit\n\t\t\t \n\t\t Case \u0026ExtrusionEstado = EstadoExtrusion.Intermedia\n\t\t      \u0026ExtActivaId = ExtrusionId\n\t\t      Exit\t \n\t EndCase\n Endfor\n \n",
      "cleanSource": " \n \u0026ExtActivaId = 0\n \u0026Disponible = false\n \n for each DB.Extrusion\n\t where ExtrusionId \u003E 0\n\t where ExtrusionId \u003C\u003E \u0026ExtrusionId\n\t where ExtrusionExtrusoraId = \u0026ExtrusoraId\n\t \u0026ExtrusionEstado = ExtrusionEstado\n\t \n\t Do Case\n\t\t Case \u0026ExtrusionEstado = EstadoExtrusion.EnProceso\n\t\t      \u0026ExtActivaId = ExtrusionId\n\t\t      Exit\n\t\t\t \n\t\t Case \u0026ExtrusionEstado = EstadoExtrusion.Intermedia\n\t\t      \u0026ExtActivaId = ExtrusionId\n\t\t      Exit\t \n\t EndCase\n Endfor"
    },
    {
      "blockName": "Rules",
      "blockType": "Rules",
      "rawSource": "parm(in:\u0026ExtrusionId, in:\u0026ExtrusoraId, out:\u0026ExtActivaId);\n",
      "cleanSource": "parm(in:\u0026ExtrusionId, in:\u0026ExtrusoraId, out:\u0026ExtActivaId);"
    }
  ],
