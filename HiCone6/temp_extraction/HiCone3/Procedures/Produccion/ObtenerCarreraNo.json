      "blockName": "Source",
      "blockType": "Source",
      "rawSource": "\u0026Prensado.Load(\u0026PrensadoId)\n\u0026PrensaId = \u0026Prensado.PrensadoPrensaId\n\u0026FechaIniciaProceso = \u0026Prensado.PrensadoHoraIniciaProceso\n\n\u0026No = 0\nfor each DB.Prensado\n\twhere PrensadoId \u003E 0\n\twhere PrensadoFecha.ToDate() = \u0026FechaIniciaProceso.ToDate()\n\twhere PrensadoPrensaId = \u0026PrensaId\n\t\u0026AuxPrensadoId = PrensadoId\n\t\n\tfor each DB.Carrera\n\t\twhere CarreraId \u003E 0\n\t\twhere InicioPBPrensadoId = \u0026AuxPrensadoId\n\t\t\u0026No \u002B= 1\n\tendfor\nendfor\n",
      "cleanSource": "\u0026Prensado.Load(\u0026PrensadoId)\n\u0026PrensaId = \u0026Prensado.PrensadoPrensaId\n\u0026FechaIniciaProceso = \u0026Prensado.PrensadoHoraIniciaProceso\n\n\u0026No = 0\nfor each DB.Prensado\n\twhere PrensadoId \u003E 0\n\twhere PrensadoFecha.ToDate() = \u0026FechaIniciaProceso.ToDate()\n\twhere PrensadoPrensaId = \u0026PrensaId\n\t\u0026AuxPrensadoId = PrensadoId\n\t\n\tfor each DB.Carrera\n\t\twhere CarreraId \u003E 0\n\t\twhere InicioPBPrensadoId = \u0026AuxPrensadoId\n\t\t\u0026No \u002B= 1\n\tendfor\nendfor"
    },
