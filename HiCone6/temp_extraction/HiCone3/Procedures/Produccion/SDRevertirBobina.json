  "description": "SDRevertir Bobina",
  "isGAMObject": false,
  "interfaceElements": [],
  "businessLogic": [
    {
      "blockName": "Source",
      "blockType": "Source",
      "rawSource": "  \n  \u0026Bobina.Load(\u0026BobinaId)\n  \u0026Bobina.BobinaEspesor = 0\n  \u0026Bobina.BobinaEstado = EstadoBobina.EnMedicion\n  \n  Do Case\n\t  Case \u0026BobinaEstado = EstadoBobina.Molino\n\t       \u0026Bobina.BobinaMermaKg = 0 \n\t       \u0026Bobina.BobinaMotivoMolino = MotivoMolino.NoAplica\n\t       \u0026Bobina.BobinaObservaciones.SetEmpty()\n\t      \n\t  Otherwise\n\t       \u0026Bobina.BobinaKg = 0       \n  EndCase\n  \n  \u0026Bobina.Save()\n  \n  if(\u0026Bobina.Success())\n\t  commit\n  endif\n",
      "cleanSource": "  \n  \u0026Bobina.Load(\u0026BobinaId)\n  \u0026Bobina.BobinaEspesor = 0\n  \u0026Bobina.BobinaEstado = EstadoBobina.EnMedicion\n  \n  Do Case\n\t  Case \u0026BobinaEstado = EstadoBobina.Molino\n\t       \u0026Bobina.BobinaMermaKg = 0 \n\t       \u0026Bobina.BobinaMotivoMolino = MotivoMolino.NoAplica\n\t       \u0026Bobina.BobinaObservaciones.SetEmpty()\n\t      \n\t  Otherwise\n\t       \u0026Bobina.BobinaKg = 0       \n  EndCase\n  \n  \u0026Bobina.Save()\n  \n  if(\u0026Bobina.Success())\n\t  commit\n  endif"
    },
    {
      "blockName": "Rules",
      "blockType": "Rules",
      "rawSource": "parm(in:\u0026BobinaId, in:\u0026BobinaEstado);\n",
      "cleanSource": "parm(in:\u0026BobinaId, in:\u0026BobinaEstado);"
    }
  ],
