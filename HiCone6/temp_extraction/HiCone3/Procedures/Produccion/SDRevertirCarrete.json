  "businessLogic": [
    {
      "blockName": "Source",
      "blockType": "Source",
      "rawSource": "       \u0026isOK = false\n       \n       //Registrar Etiquetado Operador\n       for each DB.EtiquetadoOperador\n\t       where EtiquetadoOperadorId \u003E 0\n\t       where CarreteEtiquetadoId = \u0026CarreteId\n\t       \u0026EOId = EtiquetadoOperadorId\n\t       \n\t       \u0026EtiquetadoOperador.Load(\u0026EOId)\n\t       \u0026EtiquetadoOperador.Delete()\n\t       commit\n\t       \n\t       \u0026isOK = true\n\t       Exit       \n        endfor\n\n        if(\u0026isOK)\n\t\tSetEstadoCarrete.Call(\u0026CarreteId, EstadoCarrete.Etiquetar, false)\n        endif\n",
      "cleanSource": "       \u0026isOK = false\n       \n       //Registrar Etiquetado Operador\n       for each DB.EtiquetadoOperador\n\t       where EtiquetadoOperadorId \u003E 0\n\t       where CarreteEtiquetadoId = \u0026CarreteId\n\t       \u0026EOId = EtiquetadoOperadorId\n\t       \n\t       \u0026EtiquetadoOperador.Load(\u0026EOId)\n\t       \u0026EtiquetadoOperador.Delete()\n\t       commit\n\t       \n\t       \u0026isOK = true\n\t       Exit       \n        endfor\n\n        if(\u0026isOK)\n\t\tSetEstadoCarrete.Call(\u0026CarreteId, EstadoCarrete.Etiquetar, false)\n        endif"
    },
