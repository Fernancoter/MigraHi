      "rawSource": "\n\nfor each DB.PaletCarrete\n\twhere CarreteId = \u0026CarreteId\n\t\u0026Palet.Load(PaletId)\n\t\u0026Palet.PaletNoCarretes =\u0026Palet.PaletNoCarretes -1\n\t\u0026Palet.Save()\n\t\n\tdelete\nendfor\n\n\n\n\u0026Carrete.Load(\u0026CarreteId)\n\u0026Carrete.CarreteEstado = EstadoCarrete.EnRevision\n\u0026Carrete.Save()\ncommit\n",
