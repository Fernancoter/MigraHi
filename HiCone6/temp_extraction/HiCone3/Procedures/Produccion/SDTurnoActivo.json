  "name": "SDTurnoActivo",
  "type": "Procedure",
  "module": "Produccion",
  "description": "SDTurno Activo",
  "isGAMObject": false,
  "interfaceElements": [],
  "businessLogic": [
    {
      "blockName": "Source",
      "blockType": "Source",
      "rawSource": "\u0026Tiempo = Now()\n\nfor each DB.Turno\n\twhere TurnoId \u003E 0\n\t\u0026HoraInicio = TurnoHoraInicio\n\t\u0026HoraFin = TurnoHoraFin\n\t\n        if(\u0026Tiempo \u003E= \u0026HoraInicio and \u0026Tiempo \u003C \u0026HoraFin)\n\t\t\u0026TurnoId = Produccion.TurnoId\n\t\tExit\n\tendif\n\nwhen none\n\t\u0026TurnoId = 0\nendfor\n",
      "cleanSource": "\u0026Tiempo = Now()\n\nfor each DB.Turno\n\twhere TurnoId \u003E 0\n\t\u0026HoraInicio = TurnoHoraInicio\n\t\u0026HoraFin = TurnoHoraFin\n\t\n        if(\u0026Tiempo \u003E= \u0026HoraInicio and \u0026Tiempo \u003C \u0026HoraFin)\n\t\t\u0026TurnoId = Produccion.TurnoId\n\t\tExit\n\tendif\n\nwhen none\n\t\u0026TurnoId = 0\nendfor"
    },
    {
      "blockName": "Rules",
      "blockType": "Rules",
      "rawSource": "parm(out:\u0026TurnoId);\n",
      "cleanSource": "parm(out:\u0026TurnoId);"
    }
  ],
