  "businessLogic": [
    {
      "blockName": "Source",
      "blockType": "Source",
      "rawSource": "\t\n\t\u0026Mensajes.Clear()\n\t\u0026isOK = GuardarExtrusion.Udp(\u0026CurrentItem)\n\t\n\tif(\u0026isOK)\n\t\t\n\t\tif(\u0026ExtrusionEstado = Produccion.EstadoExtrusion.Programada)\n\t\t\tSDExtrusoraBobina.Call(\u0026ExtrusionId)\n\t\tendif\n\n\t\tSetGAMAttribute.Call(\u0027ExtrusionID\u0027, \u0026ExtrusionId.ToString())\n\telse\n\t\t\u0026Msj = New()\n\t\t\u0026Msj.Id = !\u0027GuardarExtrusionFallida\u0027\n\t\t\u0026Msj.Description = \u0027No se ha podido realizar el guardado de la Extrusion (\u0027 \u002B  \u0026ExtrusionEstado.ToUpper().ToString() \u002B\u0027)\u0027\n\t\t\u0026Msj.Type = MessageTypes.Error\n\t\t\u0026Mensajes.Add(\u0026Msj)\n\tendif\n",
      "cleanSource": "\t\n\t\u0026Mensajes.Clear()\n\t\u0026isOK = GuardarExtrusion.Udp(\u0026CurrentItem)\n\t\n\tif(\u0026isOK)\n\t\t\n\t\tif(\u0026ExtrusionEstado = Produccion.EstadoExtrusion.Programada)\n\t\t\tSDExtrusoraBobina.Call(\u0026ExtrusionId)\n\t\tendif\n\n\t\tSetGAMAttribute.Call(\u0027ExtrusionID\u0027, \u0026ExtrusionId.ToString())\n\telse\n\t\t\u0026Msj = New()\n\t\t\u0026Msj.Id = !\u0027GuardarExtrusionFallida\u0027\n\t\t\u0026Msj.Description = \u0027No se ha podido realizar el guardado de la Extrusion (\u0027 \u002B  \u0026ExtrusionEstado.ToUpper().ToString() \u002B\u0027)\u0027\n\t\t\u0026Msj.Type = MessageTypes.Error\n\t\t\u0026Mensajes.Add(\u0026Msj)\n\tendif"
    },
