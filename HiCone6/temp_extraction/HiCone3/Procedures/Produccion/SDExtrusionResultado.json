  "businessLogic": [
    {
      "blockName": "Source",
      "blockType": "Source",
      "rawSource": "\t\n\t\n\tfor each DB.ExtrusionResultado\n\t\twhere ExtrusionResultadoId \u003E 0\n\t\twhere ExtrusionId = \u0026ExtrusionId\n\t\t\u0026ERId = ExtrusionResultadoId\n\t\t\u0026ExtrusionResultado.Load(\u0026ERId)\n\t\tExit\n\twhen none\n\t\t\n\t\tdo \u0027ResumenBobinas\u0027\n\t\t\n\t\t\u0026ExtrusionResultado = New()\n\t\t\u0026ExtrusionResultado.ExtrusionId = \u0026ExtrusionId\n\t\t\u0026ExtrusionResultado.ExtrusionResultadoBobinasMolino = \u0026BobinasMolino\n\t\t\u0026ExtrusionResultado.ExtrusionResultadoBobinasReposo = \u0026BobinasReposo\n\t\t\u0026ExtrusionResultado.ExtrusionResultadoTotalKg = \u0026TotalKg\n\t\t\u0026ExtrusionResultado.ExtrusionResultadoTotalMermaKg = \u0026TotalMermaKg\n\t\t\u0026ExtrusionResultado.Save()\n\t\t\n\t\tif(\u0026ExtrusionResultado.Success())\n\t\t\tcommit\n\t\tendif\n\t\t\n\tendfor\n\n        \u0026SDTExtrusionResultado = New()\n\t\u0026SDTExtrusionResultado.FromJson(\u0026ExtrusionResultado.ToJson())\n\n\n\tSub \u0027ResumenBobinas\u0027\n\t\t\n\t\t\u0026BobinasMolino = 0\n\t\t\u0026BobinasReposo = 0\n\t\t\u0026TotalKg = 0\n\t\t\u0026TotalMermaKg = 0\n\t\t\n\t\tfor each DB.Bobina\n\t\t\twhere BobinaId \u003E 0\n\t\t\twhere ExtrusionId = \u0026ExtrusionId\n\t\t\t\u0026BobinaEstado = BobinaEstado\n\t\t\t\u0026BobinaKg = BobinaKg\n\t\t\t\u0026BobinaMermaKg = BobinaMermaKg\n\t\t\t\n\t\t\tDo Case \n\t\t\t\tCase \u0026BobinaEstado = EstadoBobina.Molino\n\t\t\t\t\t\u0026BobinasMolino \u002B= 1\n\t\t\t\t\t\u0026TotalMermaKg \u002B= \u0026BobinaMermaKg\n\t\t\t\t\n\t\t\t\tCase Not \u0026BobinaEstado in (EstadoBobina.EnProceso, EstadoBobina.EnMedicion, EstadoBobina.Molino)\n\t\t\t\t\t\u0026BobinasReposo \u002B= 1\n\t\t\t\t\t\u0026TotalKg \u002B= \u0026BobinaKg\n\t\t\tEndCase\n\t\tendfor\n\t\n\tEndSub\n",
      "cleanSource": "\t\n\t\n\tfor each DB.ExtrusionResultado\n\t\twhere ExtrusionResultadoId \u003E 0\n\t\twhere ExtrusionId = \u0026ExtrusionId\n\t\t\u0026ERId = ExtrusionResultadoId\n\t\t\u0026ExtrusionResultado.Load(\u0026ERId)\n\t\tExit\n\twhen none\n\t\t\n\t\tdo \u0027ResumenBobinas\u0027\n\t\t\n\t\t\u0026ExtrusionResultado = New()\n\t\t\u0026ExtrusionResultado.ExtrusionId = \u0026ExtrusionId\n\t\t\u0026ExtrusionResultado.ExtrusionResultadoBobinasMolino = \u0026BobinasMolino\n\t\t\u0026ExtrusionResultado.ExtrusionResultadoBobinasReposo = \u0026BobinasReposo\n\t\t\u0026ExtrusionResultado.ExtrusionResultadoTotalKg = \u0026TotalKg\n\t\t\u0026ExtrusionResultado.ExtrusionResultadoTotalMermaKg = \u0026TotalMermaKg\n\t\t\u0026ExtrusionResultado.Save()\n\t\t\n\t\tif(\u0026ExtrusionResultado.Success())\n\t\t\tcommit\n\t\tendif\n\t\t\n\tendfor\n\n        \u0026SDTExtrusionResultado = New()\n\t\u0026SDTExtrusionResultado.FromJson(\u0026ExtrusionResultado.ToJson())\n\n\n\tSub \u0027ResumenBobinas\u0027\n\t\t\n\t\t\u0026BobinasMolino = 0\n\t\t\u0026BobinasReposo = 0\n\t\t\u0026TotalKg = 0\n\t\t\u0026TotalMermaKg = 0\n\t\t\n\t\tfor each DB.Bobina\n\t\t\twhere BobinaId \u003E 0\n\t\t\twhere ExtrusionId = \u0026ExtrusionId\n\t\t\t\u0026BobinaEstado = BobinaEstado\n\t\t\t\u0026BobinaKg = BobinaKg\n\t\t\t\u0026BobinaMermaKg = BobinaMermaKg\n\t\t\t\n\t\t\tDo Case \n\t\t\t\tCase \u0026BobinaEstado = EstadoBobina.Molino\n\t\t\t\t\t\u0026BobinasMolino \u002B= 1\n\t\t\t\t\t\u0026TotalMermaKg \u002B= \u0026BobinaMermaKg\n\t\t\t\t\n\t\t\t\tCase Not \u0026BobinaEstado in (EstadoBobina.EnProceso, EstadoBobina.EnMedicion, EstadoBobina.Molino)\n\t\t\t\t\t\u0026BobinasReposo \u002B= 1\n\t\t\t\t\t\u0026TotalKg \u002B= \u0026BobinaKg\n\t\t\tEndCase\n\t\tendfor\n\t\n\tEndSub"
    },
