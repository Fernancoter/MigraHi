  "businessLogic": [
    {
      "blockName": "Source",
      "blockType": "Source",
      "rawSource": "\n\n\nfor each DB.Extrusion\n\tWhere ExtrusionTurnoId = \u0026TurnoId \n\tWhere ExtrusionExtrusoraId = \u0026ExtrusoraId \n\twhere ExtrusionFecha = \u0026ExtrusionFecha \n\t\n\t\n\t\n\t\u0026ExtrusionId = ExtrusionId\n\t\u0026Extrusion.Load(\u0026ExtrusionId)\n\texit\nwhen none\n\t\u0026newExtrusionId = CrearExtrusion.Udp(\u0026TurnoId,\u0026ExtrusoraId,\u0026ExtrusionFecha,\u0026ProductoId,\u0026OperadorId)\n\t\n\tif(\u0026newExtrusionId\u003E0)\t\t\n\t\t\u0026Extrusion.Load(\u0026newExtrusionId)\n\t\t\n\telse\n\t\tmsg(\u0027Error en la configuraci\u00F3n 1\u0027)\n\tendif\nendfor\n\n\n",
      "cleanSource": "\n\n\nfor each DB.Extrusion\n\tWhere ExtrusionTurnoId = \u0026TurnoId \n\tWhere ExtrusionExtrusoraId = \u0026ExtrusoraId \n\twhere ExtrusionFecha = \u0026ExtrusionFecha \n\t\n\t\n\t\n\t\u0026ExtrusionId = ExtrusionId\n\t\u0026Extrusion.Load(\u0026ExtrusionId)\n\texit\nwhen none\n\t\u0026newExtrusionId = CrearExtrusion.Udp(\u0026TurnoId,\u0026ExtrusoraId,\u0026ExtrusionFecha,\u0026ProductoId,\u0026OperadorId)\n\t\n\tif(\u0026newExtrusionId\u003E0)\t\t\n\t\t\u0026Extrusion.Load(\u0026newExtrusionId)\n\t\t\n\telse\n\t\tmsg(\u0027Error en la configuraci\u00F3n 1\u0027)\n\tendif\nendfor"
    },
    {
      "blockName": "Rules",
      "blockType": "Rules",
      "rawSource": "parm(in:\u0026TurnoId, in:\u0026ExtrusoraId, in:\u0026ExtrusionFecha,in:\u0026ProductoId,in:\u0026OperadorId,out:\u0026Extrusion);\n",
      "cleanSource": "parm(in:\u0026TurnoId, in:\u0026ExtrusoraId, in:\u0026ExtrusionFecha,in:\u0026ProductoId,in:\u0026OperadorId,out:\u0026Extrusion);"
    }
