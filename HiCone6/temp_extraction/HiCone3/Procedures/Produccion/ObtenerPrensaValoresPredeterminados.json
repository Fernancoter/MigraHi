  "businessLogic": [
    {
      "blockName": "Source",
      "blockType": "Source",
      "rawSource": "\u0026DefaultProductoId = 0\n\u0026DefaultOperadorId = 0\n\u0026EnumTurno.FromString(\u0026TurnoId.ToString())\n\nFor each DB.PrensaProducto\t\n\tWhere DB.PrensaId = \u0026PrensaId\t\n\tWhere ComercialProductoActivo = true\n\t\u0026DefaultProductoId = ComercialProductoId\n\texit\nendfor\n\nFor each \t\n\tWhere PrensaId = \u0026PrensaId\t\n\tWhere PrensaTurnoId = \u0026EnumTurno\n\t\u0026DefaultOperadorId = PrensaOperadorId\n\texit\nendfor\n\n",
      "cleanSource": "\u0026DefaultProductoId = 0\n\u0026DefaultOperadorId = 0\n\u0026EnumTurno.FromString(\u0026TurnoId.ToString())\n\nFor each DB.PrensaProducto\t\n\tWhere DB.PrensaId = \u0026PrensaId\t\n\tWhere ComercialProductoActivo = true\n\t\u0026DefaultProductoId = ComercialProductoId\n\texit\nendfor\n\nFor each \t\n\tWhere PrensaId = \u0026PrensaId\t\n\tWhere PrensaTurnoId = \u0026EnumTurno\n\t\u0026DefaultOperadorId = PrensaOperadorId\n\texit\nendfor"
    },
    {
      "blockName": "Rules",
      "blockType": "Rules",
      "rawSource": "parm(in:\u0026PrensaId, in:\u0026TurnoId, out:\u0026DefaultProductoId, out:\u0026DefaultOperadorId);\n",
      "cleanSource": "parm(in:\u0026PrensaId, in:\u0026TurnoId, out:\u0026DefaultProductoId, out:\u0026DefaultOperadorId);"
    }
