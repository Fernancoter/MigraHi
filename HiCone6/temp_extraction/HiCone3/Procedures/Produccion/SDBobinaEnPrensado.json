      "blockName": "Source",
      "blockType": "Source",
      "rawSource": "\t\n\t\u0026BobinaId = 0\n\t\n\tfor each DB.PrensadoBobina\n\t\twhere PrensadoBobinaId \u003E 0\n\t\twhere PrensadoId = \u0026PrensadoId\n\t\twhere BobinaId \u003E 0\n\t\twhere BobinaEstado = EstadoBobina.EnPrensado\n\t\t\n\t\t\u0026BobinaId = BobinaId\n\t\t\u0026Bobina.Load(\u0026BobinaId)\n\t\t\n\t\t\u0026BobinaItem = New()\n\t\t\u0026BobinaItem.FromJson(\u0026Bobina.ToJson())\n\t\tExit\n\tendfor\n",
      "cleanSource": "\t\n\t\u0026BobinaId = 0\n\t\n\tfor each DB.PrensadoBobina\n\t\twhere PrensadoBobinaId \u003E 0\n\t\twhere PrensadoId = \u0026PrensadoId\n\t\twhere BobinaId \u003E 0\n\t\twhere BobinaEstado = EstadoBobina.EnPrensado\n\t\t\n\t\t\u0026BobinaId = BobinaId\n\t\t\u0026Bobina.Load(\u0026BobinaId)\n\t\t\n\t\t\u0026BobinaItem = New()\n\t\t\u0026BobinaItem.FromJson(\u0026Bobina.ToJson())\n\t\tExit\n\tendfor"
    },
