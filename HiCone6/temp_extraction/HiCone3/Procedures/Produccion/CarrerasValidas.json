  "description": "Carreras Validas",
  "isGAMObject": false,
  "interfaceElements": [],
  "businessLogic": [
    {
      "blockName": "Source",
      "blockType": "Source",
      "rawSource": "\t\u0026isOK = true\n\t\u0026Carreras = 0\n\t\u0026Validas = 0\n\t\n\tfor \u0026SDTCarreraItem in \u0026SDTCarrera\n\t\tif(\u0026SDTCarreraItem.CarreraEstado = EstadoCarrera.Validada)\n\t\t\t\u0026Validas \u002B= 1\n\t\tendif\n\t\n\t        \u0026Carreras \u002B= 1\n\tendfor\n \n        if(Not \u0026Carreras = \u0026Validas)\n\t      \u0026isOK = false\n              msg(\u0027Debe validar todas las carreras antes de finalizar el Prensado\u0027)\n\tendif\n",
      "cleanSource": "\t\u0026isOK = true\n\t\u0026Carreras = 0\n\t\u0026Validas = 0\n\t\n\tfor \u0026SDTCarreraItem in \u0026SDTCarrera\n\t\tif(\u0026SDTCarreraItem.CarreraEstado = EstadoCarrera.Validada)\n\t\t\t\u0026Validas \u002B= 1\n\t\tendif\n\t\n\t        \u0026Carreras \u002B= 1\n\tendfor\n \n        if(Not \u0026Carreras = \u0026Validas)\n\t      \u0026isOK = false\n              msg(\u0027Debe validar todas las carreras antes de finalizar el Prensado\u0027)\n\tendif"
    },
