  "uniqueId": "7bee6118-d162-48f3-a640-d18f77fa8335",
  "name": "ValidarCarreraCompleta",
  "type": "Procedure",
  "module": "Produccion",
  "description": "Validar Carrera Completa",
  "isGAMObject": false,
  "interfaceElements": [],
  "businessLogic": [
    {
      "blockName": "Source",
      "blockType": "Source",
      "rawSource": "\u0026ValidacionCompleta = true\n\nFor each DB.Carrete\n\tWhere CarreteCarreraId = \u0026CarreraId\n\t\n\tif(CarreteEstado = EstadoCarrete.EnRevision)\n\t\t\u0026ValidacionCompleta = false\n\t\tExit\n\tendif\nEndfor\n\nIf(\u0026ValidacionCompleta)\n\n\tSetEstadoCarrera.Call(\u0026CarreraId, EstadoCarrera.Validada)\n\tSDEliminarNotificacion.Call(\u0026CarreraId,NotificacionTipo.Carrera)\nEndif\n",
      "cleanSource": "\u0026ValidacionCompleta = true\n\nFor each DB.Carrete\n\tWhere CarreteCarreraId = \u0026CarreraId\n\t\n\tif(CarreteEstado = EstadoCarrete.EnRevision)\n\t\t\u0026ValidacionCompleta = false\n\t\tExit\n\tendif\nEndfor\n\nIf(\u0026ValidacionCompleta)\n\n\tSetEstadoCarrera.Call(\u0026CarreraId, EstadoCarrera.Validada)\n\tSDEliminarNotificacion.Call(\u0026CarreraId,NotificacionTipo.Carrera)\nEndif"
    },
    {
      "blockName": "Rules",
      "blockType": "Rules",
      "rawSource": "parm(\u0026CarreraId);\n",
      "cleanSource": "parm(\u0026CarreraId);"
    }
  ],
