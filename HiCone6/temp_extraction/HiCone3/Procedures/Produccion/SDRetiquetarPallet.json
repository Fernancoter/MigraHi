  "description": "SDRetiquetar Pallet",
  "isGAMObject": false,
  "interfaceElements": [],
  "businessLogic": [
    {
      "blockName": "Source",
      "blockType": "Source",
      "rawSource": "       \n       \u0026Palet.Load(\u0026PaletId)\n       \u0026Palet.PaletProductoId = \u0026ProductoEtiquetaId\n       \u0026Palet.PaletEstatus= EstatusPalet.Etiquetando\n       \u0026Palet.Save()\n       \n       if(\u0026Palet.Success())\n\t     commit\n\t     do \u0027EtiquetandoCarretes\u0027\n       endif\n\n       Sub \u0027EtiquetandoCarretes\u0027\n\t       \n\t       for each DB.PaletCarrete\n\t\t       where DB.PaletId = \u0026PaletId\n\t\t       where CarreteId \u003E 0\n\t\t       where CarreteEstado in (EstadoCarrete.EnPalet)\n\t\t       \u0026CarreteId = CarreteId\n\t\t       Produccion.SetEstadoCarrete.Call(\u0026CarreteId, EstadoCarrete.Etiquetar, false)\n\t       endfor\n       EndSub\n\n      \n",
      "cleanSource": "       \n       \u0026Palet.Load(\u0026PaletId)\n       \u0026Palet.PaletProductoId = \u0026ProductoEtiquetaId\n       \u0026Palet.PaletEstatus= EstatusPalet.Etiquetando\n       \u0026Palet.Save()\n       \n       if(\u0026Palet.Success())\n\t     commit\n\t     do \u0027EtiquetandoCarretes\u0027\n       endif\n\n       Sub \u0027EtiquetandoCarretes\u0027\n\t       \n\t       for each DB.PaletCarrete\n\t\t       where DB.PaletId = \u0026PaletId\n\t\t       where CarreteId \u003E 0\n\t\t       where CarreteEstado in (EstadoCarrete.EnPalet)\n\t\t       \u0026CarreteId = CarreteId\n\t\t       Produccion.SetEstadoCarrete.Call(\u0026CarreteId, EstadoCarrete.Etiquetar, false)\n\t       endfor\n       EndSub"
    },
