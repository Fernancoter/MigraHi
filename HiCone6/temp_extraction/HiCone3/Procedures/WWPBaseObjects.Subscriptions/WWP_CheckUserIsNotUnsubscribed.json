  "name": "WWP_CheckUserIsNotUnsubscribed",
  "type": "Procedure",
  "module": "WWPBaseObjects.Subscriptions",
  "description": "Check User Is Not Unsubscribed",
  "isGAMObject": false,
  "interfaceElements": [],
  "businessLogic": [
    {
      "blockName": "Source",
      "blockType": "Source",
      "rawSource": "For Each WWP_Subscription\n\tWhere WWPNotificationDefinitionId = \u0026WWPNotificationDefinitionId\n\tWhere WWPUserExtendedId = WWP_GetLoggedUserId()\n\tWhere WWPSubscriptionSubscribed = False\n\t\u0026IncludeNotification = False\n\t\u0026WWPSubscriptionId = WWPSubscriptionId\n\tExit\nEndFor\n",
      "cleanSource": "For Each WWP_Subscription\n\tWhere WWPNotificationDefinitionId = \u0026WWPNotificationDefinitionId\n\tWhere WWPUserExtendedId = WWP_GetLoggedUserId()\n\tWhere WWPSubscriptionSubscribed = False\n\t\u0026IncludeNotification = False\n\t\u0026WWPSubscriptionId = WWPSubscriptionId\n\tExit\nEndFor"
    },
    {
      "blockName": "Rules",
      "blockType": "Rules",
      "rawSource": "parm(in:\u0026WWPNotificationDefinitionId, inout:\u0026WWPSubscriptionId, inout:\u0026IncludeNotification);\n",
      "cleanSource": "parm(in:\u0026WWPNotificationDefinitionId, inout:\u0026WWPSubscriptionId, inout:\u0026IncludeNotification);"
    }
  ],
