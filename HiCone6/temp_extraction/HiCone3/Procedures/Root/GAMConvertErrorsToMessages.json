  "description": "GAMConvert Errors To Messages",
  "isGAMObject": true,
  "interfaceElements": [],
  "businessLogic": [
    {
      "blockName": "Source",
      "blockType": "Source",
      "rawSource": "For \u0026GAMError in \u0026GAMErrorCollection\n\t\u0026Message = new()\n\t\u0026Message.Type = MessageTypes.Error\n\t\u0026Message.Description = \u0026GAMError.Message\n\t\u0026Message.Id = Format(!\u0022GAM%2\u0022, \u0026GAMError.Code)\n\t\u0026Messages.Add(\u0026Message)\nEndFor\n",
      "cleanSource": "For \u0026GAMError in \u0026GAMErrorCollection\n\t\u0026Message = new()\n\t\u0026Message.Type = MessageTypes.Error\n\t\u0026Message.Description = \u0026GAMError.Message\n\t\u0026Message.Id = Format(!\u0022GAM%2\u0022, \u0026GAMError.Code)\n\t\u0026Messages.Add(\u0026Message)\nEndFor"
    },
    {
      "blockName": "Rules",
      "blockType": "Rules",
      "rawSource": "Parm(in:\u0026GAMErrorCollection, out:\u0026Messages);\n\t\n",
      "cleanSource": "Parm(in:\u0026GAMErrorCollection, out:\u0026Messages);"
    }
  ],
